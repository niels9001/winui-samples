{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niels9001.github.io/winui-samples/schema/federated/v1/source-lock.schema.json",
  "title": "Federated catalog source locks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "locks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "locks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/providerLock"
      }
    }
  },
  "$defs": {
    "providerId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "maxLength": 100
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*%2[eEfF]|.*%5[cC])[^\\u0000]+$"
    },
    "providerLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "repository",
        "ref",
        "commitSha",
        "treeSha",
        "commitTime",
        "artifacts"
      ],
      "properties": {
        "providerId": {
          "$ref": "#/$defs/providerId"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "name"
          ],
          "properties": {
            "owner": {
              "$ref": "#/$defs/repositoryName"
            },
            "name": {
              "$ref": "#/$defs/repositoryName"
            }
          }
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "commitSha": {
          "$ref": "#/$defs/gitSha"
        },
        "treeSha": {
          "$ref": "#/$defs/gitSha"
        },
        "commitTime": {
          "$ref": "#/$defs/dateTime"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "blobSha",
              "sha256",
              "size",
              "mediaType",
              "cachePath"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "blobSha": {
                "$ref": "#/$defs/gitSha"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10485760
              },
              "mediaType": {
                "type": "string",
                "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
                "maxLength": 100
              },
              "cachePath": {
                "$ref": "#/$defs/relativePath"
              }
            }
          }
        }
      }
    }
  }
}
