{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niels9001.github.io/winui-samples/schema/federated/v1/sync-history.schema.json",
  "title": "Reviewed external catalog sync history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "providers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/providerHistory"
      }
    }
  },
  "$defs": {
    "syncId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reviewedSync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reviewedAt",
        "lockCommitSha"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/syncId"
        },
        "reviewedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
        },
        "lockCommitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "recordHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recordKey",
        "routePath",
        "status",
        "firstSeenSync",
        "lastReviewedSync",
        "lastChangedSync",
        "removedAtSync"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[A-Za-z0-9][A-Za-z0-9._~/-]*$"
        },
        "recordKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~/-]*$"
        },
        "routePath": {
          "type": "string",
          "pattern": "^samples/(?!\\.\\.?$)(?!\\.\\.?/)(?!.*(?:/\\.\\.?$|/\\.\\.?/))(?!.*%[0-9a-fA-F]{2})[A-Za-z0-9._~/-]+$",
          "maxLength": 300
        },
        "status": {
          "enum": [
            "active",
            "tombstoned"
          ]
        },
        "firstSeenSync": {
          "$ref": "#/$defs/syncId"
        },
        "lastReviewedSync": {
          "$ref": "#/$defs/syncId"
        },
        "lastChangedSync": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "removedAtSync": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "providerHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "latestSyncId",
        "syncs",
        "records"
      ],
      "properties": {
        "providerId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "latestSyncId": {
          "$ref": "#/$defs/syncId"
        },
        "syncs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reviewedSync"
          }
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recordHistory"
          }
        }
      }
    }
  }
}
