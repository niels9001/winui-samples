{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niels9001.github.io/winui-samples/schema/federated/v1/provider-output.schema.json",
  "title": "Normalized output from one external catalog provider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerId",
    "reviewedSync",
    "lock",
    "records",
    "redirects",
    "tombstones",
    "licenseManifest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "reviewedSync": {
      "$ref": "#/$defs/reviewedSync"
    },
    "lock": {
      "$ref": "https://niels9001.github.io/winui-samples/schema/federated/v1/source-lock.schema.json#/$defs/providerLock"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "https://niels9001.github.io/winui-samples/schema/federated/v1/normalized-record.schema.json"
      }
    },
    "redirects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/redirect"
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tombstone"
      }
    },
    "licenseManifest": {
      "anyOf": [
        {
          "$ref": "https://niels9001.github.io/winui-samples/schema/federated/v1/license-manifest.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "reviewedSync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reviewedAt",
        "lockCommitSha"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
        },
        "lockCommitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromPath",
        "toId",
        "declaredAtSync",
        "reason"
      ],
      "properties": {
        "fromPath": {
          "type": "string",
          "pattern": "^samples/(?!\\.\\.?$)(?!\\.\\.?/)(?!.*(?:/\\.\\.?$|/\\.\\.?/))(?!.*%[0-9a-fA-F]{2})[A-Za-z0-9._~/-]+$",
          "maxLength": 300
        },
        "toId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[A-Za-z0-9][A-Za-z0-9._~/-]*$"
        },
        "declaredAtSync": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerId",
        "recordKey",
        "routePath",
        "removedAtSync",
        "reason",
        "redirectToId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[A-Za-z0-9][A-Za-z0-9._~/-]*$"
        },
        "providerId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "recordKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~/-]*$"
        },
        "routePath": {
          "type": "string",
          "pattern": "^samples/(?!\\.\\.?$)(?!\\.\\.?/)(?!.*(?:/\\.\\.?$|/\\.\\.?/))(?!.*%[0-9a-fA-F]{2})[A-Za-z0-9._~/-]+$",
          "maxLength": 300
        },
        "removedAtSync": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "redirectToId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[A-Za-z0-9][A-Za-z0-9._~/-]*$"
        }
      }
    }
  }
}
