<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel
                MaxWidth="1120"
                Margin="24"
                HorizontalAlignment="Left"
                Spacing="16">
                <TextBlock
                    x:Uid="ImportHeading"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="ImportDescription"
                    MaxWidth="920"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="FindSourcesButton"
                        x:Uid="FindSourcesButton"
                        Click="FindSourcesButton_Click" />
                    <Button
                        x:Name="CancelButton"
                        x:Uid="CancelButton"
                        Click="CancelButton_Click"
                        IsEnabled="False" />
                    <ProgressRing
                        x:Name="OperationProgressRing"
                        Width="32"
                        Height="32"
                        IsActive="False" />
                </StackPanel>

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="720" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="SourcesHeading"
                            FontSize="16"
                            FontWeight="SemiBold" />
                        <ListView
                            x:Name="SourceListView"
                            x:Uid="SourceListView"
                            Height="160"
                            SelectionChanged="SourceListView_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Opacity="0.7"
                                            Text="{Binding Description}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            x:Uid="SourceDetailsHeading"
                            FontSize="16"
                            FontWeight="SemiBold" />
                        <TextBox
                            x:Name="SourceDetailsTextBox"
                            x:Uid="SourceDetailsTextBox"
                            Height="190"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="12">
                        <TextBlock
                            x:Uid="ItemsHeading"
                            FontSize="16"
                            FontWeight="SemiBold" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <ComboBox
                                x:Name="ContentFilterComboBox"
                                x:Uid="ContentFilterComboBox"
                                Width="190"
                                SelectedIndex="0">
                                <ComboBoxItem
                                    x:Uid="ImagesAndVideosOption"
                                    Tag="ImagesAndVideos" />
                                <ComboBoxItem
                                    x:Uid="ImagesOnlyOption"
                                    Tag="OnlyImages" />
                                <ComboBoxItem
                                    x:Uid="VideosOnlyOption"
                                    Tag="OnlyVideos" />
                            </ComboBox>
                            <Button
                                x:Name="FindNewItemsButton"
                                x:Uid="FindNewItemsButton"
                                Click="FindNewItemsButton_Click"
                                IsEnabled="False" />
                            <Button
                                x:Name="FindAllItemsButton"
                                x:Uid="FindAllItemsButton"
                                Click="FindAllItemsButton_Click"
                                IsEnabled="False" />
                        </StackPanel>

                        <ListView
                            x:Name="ItemsListView"
                            x:Uid="ItemsListView"
                            Height="300"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        MinHeight="42"
                                        Padding="6"
                                        ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            AutomationProperties.LabeledBy="{Binding ElementName=ItemNameTextBlock}"
                                            Click="ItemSelectionCheckBox_Click"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        <TextBlock
                                            x:Name="ItemNameTextBlock"
                                            Grid.Column="1"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="SelectNewButton"
                                x:Uid="SelectNewButton"
                                Click="SelectNewButton_Click"
                                IsEnabled="False" />
                            <Button
                                x:Name="SelectAllButton"
                                x:Uid="SelectAllButton"
                                Click="SelectAllButton_Click"
                                IsEnabled="False" />
                            <Button
                                x:Name="SelectNoneButton"
                                x:Uid="SelectNoneButton"
                                Click="SelectNoneButton_Click"
                                IsEnabled="False" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="AppendDateCheckBox"
                                x:Uid="AppendDateCheckBox"
                                IsChecked="True"
                                IsEnabled="False" />
                            <ComboBox
                                x:Name="SubfolderModeComboBox"
                                x:Uid="SubfolderModeComboBox"
                                Grid.Column="1"
                                IsEnabled="False"
                                SelectedIndex="1">
                                <ComboBoxItem
                                    x:Uid="NoSubfolderOption"
                                    Tag="DoNotCreateSubfolders" />
                                <ComboBoxItem
                                    x:Uid="FileDateSubfolderOption"
                                    Tag="CreateSubfoldersFromFileDate" />
                                <ComboBoxItem
                                    x:Uid="ExifDateSubfolderOption"
                                    Tag="CreateSubfoldersFromExifDate" />
                                <ComboBoxItem
                                    x:Uid="KeepOriginalFoldersOption"
                                    Tag="KeepOriginalFolderStructure" />
                            </ComboBox>
                        </Grid>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="ImportButton"
                                x:Uid="ImportButton"
                                Click="ImportButton_Click"
                                IsEnabled="False" />
                            <Button
                                x:Name="DeleteImportedButton"
                                x:Uid="DeleteImportedButton"
                                Click="DeleteImportedButton_Click"
                                IsEnabled="False" />
                        </StackPanel>

                        <ProgressBar
                            x:Name="OperationProgressBar"
                            x:Uid="OperationProgressBar"
                            Maximum="1"
                            Minimum="0"
                            Value="0" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    x:Uid="ResultsHeading"
                    FontSize="16"
                    FontWeight="SemiBold" />
                <TextBox
                    x:Name="ResultsTextBox"
                    x:Uid="ResultsTextBox"
                    MinHeight="110"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="12,0,12,12"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
