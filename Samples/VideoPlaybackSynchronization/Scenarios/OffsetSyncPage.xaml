<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SDKTemplate.OffsetSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid
            Margin="24"
            MaxWidth="1200"
            HorizontalAlignment="Stretch"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel MaxWidth="850" HorizontalAlignment="Left" Spacing="8">
                <TextBlock
                    x:Uid="OffsetPageTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="OffsetPageDescription"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ToggleSwitch
                x:Name="OffsetCorrectionToggle"
                x:Uid="OffsetCorrectionToggle"
                AutomationProperties.AutomationId="OffsetCorrectionToggle"
                Grid.Row="1"
                IsOn="True" />

            <Grid
                Grid.Row="2"
                Height="330"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="Black" CornerRadius="4">
                    <MediaPlayerElement
                        x:Name="ReferencePlayerElement"
                        x:Uid="ReferencePlayerElement"
                        AreTransportControlsEnabled="False"
                        Stretch="Uniform" />
                </Border>
                <Border
                    Grid.Column="1"
                    Background="Black"
                    CornerRadius="4">
                    <MediaPlayerElement
                        x:Name="DelayedPlayerElement"
                        x:Uid="DelayedPlayerElement"
                        AreTransportControlsEnabled="False"
                        Stretch="Uniform" />
                </Border>
            </Grid>

            <CommandBar Grid.Row="3" DefaultLabelPosition="Right">
                <CommandBar.Content>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <ProgressRing
                            x:Name="LoadingProgressRing"
                            x:Uid="LoadingProgressRing"
                            Width="20"
                            Height="20"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="PlaybackStatusTextBlock"
                                x:Uid="OffsetInitialStatus"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="PlaybackPositionTextBlock"
                                x:Uid="PlaybackPositionInitial"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>
                </CommandBar.Content>

                <AppBarButton
                    x:Name="LoadButton"
                    x:Uid="LoadOffsetMediaButton"
                    AutomationProperties.AutomationId="LoadOffsetMediaButton"
                    Click="LoadButton_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Refresh" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton
                    x:Name="SeekBackButton"
                    x:Uid="SeekBack2Button"
                    AutomationProperties.AutomationId="OffsetSeekBackButton"
                    Click="SeekBackButton_Click"
                    IsEnabled="False">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Back" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="PlayPauseButton"
                    x:Uid="PlayPauseButton"
                    AutomationProperties.AutomationId="OffsetPlayPauseButton"
                    Click="PlayPauseButton_Click"
                    IsEnabled="False">
                    <AppBarButton.Icon>
                        <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="SeekForwardButton"
                    x:Uid="SeekForward2Button"
                    AutomationProperties.AutomationId="OffsetSeekForwardButton"
                    Click="SeekForwardButton_Click"
                    IsEnabled="False">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Forward" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>
    </ScrollViewer>
</Page>
