<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SDKTemplate.Scenario2_DisplayText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Margin="24"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock
                x:Uid="DisplayTextHeading"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Uid="DisplayTextDescription"
                MaxWidth="720"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <CheckBox
                x:Name="BlinkCheckBox"
                x:Uid="BlinkCheckBox"
                AutomationProperties.AutomationId="BlinkTextCheckBox" />
            <CheckBox
                x:Name="CenterCheckBox"
                x:Uid="CenterCheckBox"
                AutomationProperties.AutomationId="CenterTextCheckBox" />
            <Button
                x:Name="DisplayTextButton"
                x:Uid="DisplayTextButton"
                AutomationProperties.AutomationId="DisplayTextButton"
                Click="DisplayTextButton_Click"
                IsEnabled="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
