<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SDKTemplate.Scenario1_SelectDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Margin="24"
            HorizontalAlignment="Stretch"
            Spacing="12">
            <TextBlock
                x:Uid="SelectDisplayHeading"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Uid="SelectDisplayDescription"
                MaxWidth="720"
                HorizontalAlignment="Left"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <ListView
                x:Name="DisplaysListView"
                x:Uid="DisplaysListView"
                AutomationProperties.AutomationId="DisplaysListView"
                Height="260"
                ItemsSource="{x:Bind Devices, Mode=OneWay}"
                SelectionChanged="DisplaysListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LineDisplayDevice">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="SelectButton"
                    x:Uid="SelectButton"
                    AutomationProperties.AutomationId="SelectLineDisplayButton"
                    Click="SelectButton_Click"
                    IsEnabled="False" />
                <Button
                    x:Uid="RefreshButton"
                    AutomationProperties.AutomationId="RefreshLineDisplaysButton"
                    Click="RefreshButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
