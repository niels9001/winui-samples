<Page
    x:Class="SDKTemplate.Scenario2_Connector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wifidirect="using:Windows.Devices.WiFiDirect"
    mc:Ignorable="d">

    <ScrollViewer
        Padding="24,16,24,24"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel Spacing="12">
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Discover and connect" />
            <TextBlock
                Style="{StaticResource ScenarioDescriptionTextStyle}"
                Text="Discover nearby Wi-Fi Direct devices, inspect their information elements, and explicitly pair and connect before exchanging text over a TCP socket."
                TextWrapping="Wrap" />

            <VariableSizedWrapGrid Orientation="Horizontal">
                <StackPanel
                    Width="360"
                    Margin="0,8,16,0"
                    Padding="8"
                    Spacing="8">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Discovery" />
                    <TextBlock Text="Device selector" />
                    <ComboBox
                        x:Name="DeviceSelectorComboBox"
                        AutomationProperties.AutomationId="DeviceSelectorComboBox"
                        AutomationProperties.Name="Wi-Fi Direct device selector"
                        MinWidth="220">
                        <ComboBoxItem Content="Device interface">
                            <ComboBoxItem.Tag>
                                <wifidirect:WiFiDirectDeviceSelectorType>DeviceInterface</wifidirect:WiFiDirectDeviceSelectorType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Association endpoint" IsSelected="True">
                            <ComboBoxItem.Tag>
                                <wifidirect:WiFiDirectDeviceSelectorType>AssociationEndpoint</wifidirect:WiFiDirectDeviceSelectorType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="WatcherButton"
                            AutomationProperties.AutomationId="WatcherButton"
                            AutomationProperties.Name="Start Wi-Fi Direct device discovery"
                            Click="WatcherButton_Click"
                            Content="Start watcher" />
                        <Button
                            x:Name="ShowInformationElementsButton"
                            AutomationProperties.AutomationId="ShowInformationElementsButton"
                            AutomationProperties.Name="Show information elements for selected device"
                            Click="ShowInformationElementsButton_Click"
                            Content="Show information elements"
                            IsEnabled="False" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Width="380"
                    Margin="0,8,0,0"
                    Padding="8"
                    Spacing="8">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Discovered devices" />
                    <ListView
                        x:Name="DiscoveredDevicesListView"
                        AutomationProperties.AutomationId="DiscoveredDevicesList"
                        AutomationProperties.Name="Discovered Wi-Fi Direct devices"
                        Height="220"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{x:Bind DiscoveredDevices}"
                        SelectionChanged="DiscoveredDevicesListView_SelectionChanged"
                        SelectionMode="Single" />
                </StackPanel>
            </VariableSizedWrapGrid>

            <VariableSizedWrapGrid Orientation="Horizontal">
                <StackPanel
                    Width="360"
                    Margin="0,8,16,0"
                    Padding="8"
                    Spacing="8">
                    <local:ConnectionSettingsPanel
                        x:Name="ConnectionSettingsPanel"
                        Width="344" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ConnectButton"
                            AutomationProperties.AutomationId="ConnectButton"
                            AutomationProperties.Name="Connect to selected Wi-Fi Direct device"
                            Click="ConnectButton_Click"
                            Content="Connect"
                            IsEnabled="False" />
                        <Button
                            x:Name="UnpairButton"
                            AutomationProperties.AutomationId="UnpairButton"
                            AutomationProperties.Name="Unpair selected Wi-Fi Direct device"
                            Click="UnpairButton_Click"
                            Content="Unpair"
                            IsEnabled="False" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Width="380"
                    Margin="0,8,0,0"
                    Padding="8"
                    Spacing="8">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Connected devices" />
                    <ListView
                        x:Name="ConnectedDevicesListView"
                        AutomationProperties.AutomationId="ConnectorConnectedDevicesList"
                        AutomationProperties.Name="Connected Wi-Fi Direct devices"
                        Height="220"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{x:Bind ConnectedDevices}"
                        SelectionChanged="ConnectedDevicesListView_SelectionChanged"
                        SelectionMode="Single" />
                </StackPanel>
            </VariableSizedWrapGrid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CloseDeviceButton"
                    AutomationProperties.AutomationId="ConnectorCloseDeviceButton"
                    AutomationProperties.Name="Close selected device"
                    Click="CloseDeviceButton_Click"
                    Content="Close device"
                    IsEnabled="False" />
                <TextBox
                    x:Name="SendMessageTextBox"
                    AutomationProperties.AutomationId="ConnectorMessageTextBox"
                    AutomationProperties.Name="Message to send"
                    MinWidth="260"
                    PlaceholderText="Enter a message"
                    TextChanged="SendMessageTextBox_TextChanged" />
                <Button
                    x:Name="SendMessageButton"
                    AutomationProperties.AutomationId="ConnectorSendMessageButton"
                    AutomationProperties.Name="Send message"
                    Click="SendMessageButton_Click"
                    Content="Send"
                    IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
