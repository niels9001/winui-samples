<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.Scenario4_GiftDispatch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Margin="24,20,24,24"
            Spacing="12">
            <TextBlock
                x:Uid="DescriptionLabel"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Uid="GiftDispatchDescription"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />

            <Button
                x:Name="ShowGiftsButton"
                x:Uid="ShowGiftsButton"
                AutomationProperties.AutomationId="ShowGiftsButton"
                Click="ShowGiftsButton_Click" />

            <TextBlock
                x:Uid="EmployeeProfileLabel"
                Margin="0,8,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <RichEditBox
                x:Name="EmployeeProfileBox"
                x:Uid="EmployeeProfileBox"
                AutomationProperties.AutomationId="EmployeeProfileBox"
                IsReadOnly="True"
                MinHeight="190" />

            <TextBlock
                x:Uid="ResultLabel"
                Margin="0,8,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <RichEditBox
                x:Name="ResultBox"
                x:Uid="GiftDispatchResultBox"
                AutomationProperties.AutomationId="GiftDispatchResultBox"
                IsReadOnly="True"
                MinHeight="150" />
        </StackPanel>
    </ScrollViewer>
</Page>
