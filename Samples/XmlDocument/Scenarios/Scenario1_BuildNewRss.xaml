<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.Scenario1_BuildNewRss"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Margin="24,20,24,24"
            Spacing="12">
            <TextBlock
                x:Uid="DescriptionLabel"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Uid="BuildRssDescription"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />

            <TextBlock
                x:Uid="RssContentLabel"
                Margin="0,4,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox
                x:Name="RssContentInput"
                x:Uid="RssContentInput"
                AutomationProperties.AutomationId="RssContentInput"
                MaxLength="4096" />
            <Button
                x:Name="BuildRssButton"
                x:Uid="BuildRssButton"
                AutomationProperties.AutomationId="BuildRssButton"
                Click="BuildRssButton_Click" />

            <TextBlock
                x:Uid="RssTemplateLabel"
                Margin="0,8,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <RichEditBox
                x:Name="RssTemplateBox"
                x:Uid="RssTemplateBox"
                AutomationProperties.AutomationId="RssTemplateBox"
                IsReadOnly="True"
                MinHeight="150" />

            <TextBlock
                x:Uid="ResultLabel"
                Margin="0,8,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <RichEditBox
                x:Name="ResultBox"
                x:Uid="BuildRssResultBox"
                AutomationProperties.AutomationId="BuildRssResultBox"
                IsReadOnly="True"
                MinHeight="150" />
        </StackPanel>
    </ScrollViewer>
</Page>
