<Page
    x:Class="SDKTemplate.Scenario1_GetDeviceInformation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel
                Margin="24"
                HorizontalAlignment="Left"
                Spacing="16">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Get device information" />
                <TextBlock
                    MaxWidth="720"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Retrieve identifying properties that an Exchange ActiveSync client can use to describe the current device."
                    TextWrapping="Wrap" />

                <Grid
                    MaxWidth="640"
                    HorizontalAlignment="Left"
                    ColumnSpacing="16"
                    RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="Device ID" />
                    <TextBox
                        x:Name="DeviceIdTextBox"
                        Grid.Column="1"
                        IsReadOnly="True" />

                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Text="Operating system" />
                    <TextBox
                        x:Name="OperatingSystemTextBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        IsReadOnly="True" />

                    <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        Text="Friendly name" />
                    <TextBox
                        x:Name="FriendlyNameTextBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        IsReadOnly="True" />

                    <TextBlock
                        Grid.Row="3"
                        VerticalAlignment="Center"
                        Text="System manufacturer" />
                    <TextBox
                        x:Name="SystemManufacturerTextBox"
                        Grid.Row="3"
                        Grid.Column="1"
                        IsReadOnly="True" />

                    <TextBlock
                        Grid.Row="4"
                        VerticalAlignment="Center"
                        Text="System product name" />
                    <TextBox
                        x:Name="SystemProductNameTextBox"
                        Grid.Row="4"
                        Grid.Column="1"
                        IsReadOnly="True" />

                    <TextBlock
                        Grid.Row="5"
                        VerticalAlignment="Center"
                        Text="System SKU" />
                    <TextBox
                        x:Name="SystemSkuTextBox"
                        Grid.Row="5"
                        Grid.Column="1"
                        IsReadOnly="True" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        Click="GetInformation_Click"
                        Content="Get device information" />
                    <Button
                        Click="Reset_Click"
                        Content="Reset" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="12,0,12,12"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
