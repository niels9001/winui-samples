<Page
    x:Class="SDKTemplate.Scenarios.CertificatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Margin="28"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="SSL/TLS server certificates" />
            <TextBlock
                MaxWidth="700"
                Text="Connect with TLS 1.2, inspect the server certificate validation errors, and display certificate properties after an explicit test-only retry."
                TextWrapping="Wrap" />
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="This page starts a local TLS server with an intentionally untrusted certificate issued to www.fabrikam.com. Ignoring certificate errors is unsafe in production and can enable man-in-the-middle attacks."
                Severity="Warning"
                Title="Test certificate only" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="HostNameTextBox"
                    AutomationProperties.AutomationId="TlsHostNameTextBox"
                    Header="Host name"
                    IsReadOnly="True"
                    Text="localhost" />
                <TextBox
                    x:Name="ServiceNameTextBox"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="TlsServiceNameTextBox"
                    Header="TCP port"
                    IsReadOnly="True" />
            </Grid>

            <Button
                x:Name="ConnectButton"
                AutomationProperties.AutomationId="TlsConnectButton"
                Click="ConnectButton_Click"
                Content="Connect and inspect certificate"
                Style="{StaticResource AccentButtonStyle}" />

            <TextBox
                x:Name="CertificateOutputTextBox"
                MinHeight="180"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="CertificateOutputTextBox"
                FontFamily="Consolas"
                Header="Certificate information"
                IsReadOnly="True"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
