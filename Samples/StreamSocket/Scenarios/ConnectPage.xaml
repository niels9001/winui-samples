<Page
    x:Class="SDKTemplate.Scenarios.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Margin="28"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Connect to listener" />
            <TextBlock
                MaxWidth="680"
                Text="Create a StreamSocket client and connect it to the listener from scenario 1. If that listener was bound to an adapter, the client uses the same adapter."
                TextWrapping="Wrap" />
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="For the local walkthrough, start the listener in scenario 1 before connecting."
                Severity="Informational"
                Title="Before connecting" />

            <TextBox
                x:Name="HostNameTextBox"
                Width="360"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="ConnectHostNameTextBox"
                Header="Host name"
                Text="localhost" />
            <TextBox
                x:Name="ServiceNameTextBox"
                Width="260"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="ConnectServiceNameTextBox"
                Header="Service name or TCP port"
                Text="22112" />
            <TextBlock
                x:Name="AdapterTextBlock"
                MaxWidth="680"
                TextWrapping="Wrap" />

            <Button
                x:Name="ConnectButton"
                AutomationProperties.AutomationId="ConnectButton"
                Click="ConnectButton_Click"
                Content="Connect"
                Style="{StaticResource AccentButtonStyle}" />

            <TextBlock
                x:Name="ConnectionStateTextBlock"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
