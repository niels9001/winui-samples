<Page
    x:Class="SDKTemplate.Scenarios.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Margin="28"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Send data" />
            <TextBlock
                MaxWidth="680"
                Text="Send a length-prefixed UTF-8 string over the connected StreamSocket. The listener reads the 32-bit length first, then reads and displays the message."
                TextWrapping="Wrap" />

            <TextBox
                x:Name="MessageTextBox"
                MinWidth="420"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="MessageTextBox"
                Header="Message"
                Text="Hello" />
            <Button
                x:Name="SendButton"
                AutomationProperties.AutomationId="SendButton"
                Click="SendButton_Click"
                Content="Send data"
                Style="{StaticResource AccentButtonStyle}" />

            <TextBlock
                x:Name="SendStateTextBlock"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
