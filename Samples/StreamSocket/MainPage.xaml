<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="NavView"
        AutomationProperties.AutomationId="ScenarioNavigationView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                AutomationProperties.AutomationId="StartListenerNavigationItem"
                Content="1. Start StreamSocketListener"
                Tag="start-listener" />
            <NavigationViewItem
                AutomationProperties.AutomationId="ConnectNavigationItem"
                Content="2. Connect to Listener"
                Tag="connect" />
            <NavigationViewItem
                AutomationProperties.AutomationId="SendNavigationItem"
                Content="3. Send Data"
                Tag="send" />
            <NavigationViewItem
                AutomationProperties.AutomationId="CloseNavigationItem"
                Content="4. Close Socket"
                Tag="close" />
            <NavigationViewItem
                AutomationProperties.AutomationId="CertificatesNavigationItem"
                Content="5. SSL/TLS Server Certificates"
                Tag="certificates" />
        </NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Frame x:Name="ScenarioFrame" />

            <InfoBar
                x:Name="StatusInfoBar"
                Grid.Row="1"
                Margin="12,0,12,12"
                IsClosable="True"
                IsOpen="False" />
        </Grid>
    </NavigationView>
</Page>
