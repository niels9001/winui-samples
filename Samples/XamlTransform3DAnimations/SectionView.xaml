<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SDKTemplate.SectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SDKTemplate"
    xmlns:viewmodels="using:SDKTemplate.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d"
    Unloaded="SectionView_Unloaded">

    <UserControl.Clip>
        <RectangleGeometry x:Name="ClipGeometry" />
    </UserControl.Clip>

    <Grid
        x:Name="LayoutRoot"
        SizeChanged="LayoutRoot_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ContentTransitionStates">
                <VisualState x:Name="ContentSteadyState" />

                <VisualState x:Name="ContentTransitionState">
                    <Storyboard
                        x:Name="ContentTransitionStoryboard"
                        Completed="ContentTransitionStoryboard_Completed">
                        <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="NextContentRoot"
                            Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                        </ObjectAnimationUsingKeyFrames>

                        <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="NextContentRoot"
                            Storyboard.TargetProperty="(Canvas.ZIndex)">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                            <DiscreteObjectKeyFrame KeyTime="0:0:0.4" Value="1" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="CurrentContentRoot"
                            Storyboard.TargetProperty="(Canvas.ZIndex)">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                            <DiscreteObjectKeyFrame KeyTime="0:0:0.4" Value="0" />
                        </ObjectAnimationUsingKeyFrames>

                        <DoubleAnimation
                            Storyboard.TargetName="NextContentShadow"
                            Storyboard.TargetProperty="Opacity"
                            Duration="0:0:0.8"
                            From="0.08"
                            To="0" />
                        <DoubleAnimation
                            Storyboard.TargetName="CurrentContentShadow"
                            Storyboard.TargetProperty="Opacity"
                            Duration="0:0:0.8"
                            From="0"
                            To="0.08" />

                        <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="RootTransform"
                            Storyboard.TargetProperty="RotationY">
                            <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                            <SplineDoubleKeyFrame
                                KeySpline=".5,.1,.5,.9"
                                KeyTime="0:0:0.8"
                                Value="90" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.Resources>
            <DataTemplate
                x:Key="HeroArticleTemplate"
                x:DataType="viewmodels:ArticleViewModel">
                <Button
                    AutomationProperties.Name="{x:Bind Headline}"
                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                    BorderThickness="0"
                    Click="ArticleButton_Click"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    VerticalContentAlignment="Stretch">
                    <Grid Padding="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Text="{x:Bind Headline}"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            Text="{x:Bind FullText}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            TextTrimming="Clip"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>
            </DataTemplate>

            <DataTemplate
                x:Key="StackedHeroArticlesTemplate"
                x:DataType="viewmodels:HeroArticlesViewModel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ContentControl
                        Content="{x:Bind Article0}"
                        ContentTemplate="{StaticResource HeroArticleTemplate}" />
                    <ContentControl
                        Grid.Row="1"
                        Content="{x:Bind Article1}"
                        ContentTemplate="{StaticResource HeroArticleTemplate}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.Transform3D>
            <CompositeTransform3D x:Name="RootTransform" />
        </Grid.Transform3D>

        <Grid
            x:Name="CurrentContentRoot"
            Margin="0,0,0,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ContentPresenter
                x:Name="CurrentContentPresenter"
                ContentTemplate="{StaticResource StackedHeroArticlesTemplate}" />
            <Rectangle
                x:Name="CurrentContentShadow"
                Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                IsHitTestVisible="False"
                Opacity="0" />
        </Grid>

        <Grid
            x:Name="NextContentRoot"
            Margin="0,0,0,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid.Transform3D>
                <CompositeTransform3D
                    x:Name="NextContentTransform"
                    RotationY="270" />
            </Grid.Transform3D>

            <ContentPresenter
                x:Name="NextContentPresenter"
                ContentTemplate="{StaticResource StackedHeroArticlesTemplate}" />
            <Rectangle
                x:Name="NextContentShadow"
                Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                IsHitTestVisible="False"
                Opacity="0" />
        </Grid>
    </Grid>
</UserControl>
