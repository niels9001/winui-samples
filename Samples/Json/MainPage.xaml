<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel
                Margin="24"
                MaxWidth="900"
                HorizontalAlignment="Left"
                Spacing="12">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Parse and stringify JSON" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Convert a JSON string into editable .NET objects using Windows.Data.Json, then serialize the edited values back to JSON."
                    TextWrapping="Wrap" />

                <TextBlock Text="JSON input" />
                <TextBox
                    x:Name="JsonInput"
                    Height="220"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap"
                    xml:space="preserve"><TextBox.Text>{
  "id": "1146217767",
  "phone": null,
  "name": "Satya Nadella",
  "education": [
    {
      "school": {
        "id": "204165836287254",
        "name": "Contoso High School"
      },
      "type": "High School"
    },
    {
      "school": {
        "id": "116138758396662",
        "name": "Contoso University"
      },
      "type": "College"
    }
  ],
  "timezone": -8,
  "verified": true
}</TextBox.Text></TextBox>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="Parse_Click"
                        Content="Parse" />
                    <Button
                        Click="Stringify_Click"
                        Content="Stringify" />
                </StackPanel>

                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Object values" />

                <Grid
                    ColumnSpacing="12"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        Text="ID" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="{Binding Id, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Text="Phone" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        PlaceholderText="null"
                        Text="{Binding Phone, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        Text="Name" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="{Binding Name, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="3"
                        VerticalAlignment="Center"
                        Text="Timezone" />
                    <NumberBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Maximum="14"
                        Minimum="-12"
                        SmallChange="0.5"
                        SpinButtonPlacementMode="Inline"
                        Value="{Binding Timezone, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="4"
                        VerticalAlignment="Center"
                        Text="Verified" />
                    <ToggleSwitch
                        Grid.Row="4"
                        Grid.Column="1"
                        IsOn="{Binding Verified, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="Education array" />
                <ListView
                    x:Name="EducationList"
                    MinHeight="150"
                    ItemsSource="{Binding Education}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="0,4"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="ID"
                                    Text="{Binding Id, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Column="1"
                                    Header="School"
                                    Text="{Binding Name, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Column="2"
                                    Header="Type"
                                    Text="{Binding Type, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="3"
                                    VerticalAlignment="Bottom"
                                    Click="DeleteSchool_Click"
                                    ToolTipService.ToolTip="Delete school">
                                    <SymbolIcon Symbol="Delete" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button
                    HorizontalAlignment="Left"
                    Click="AddSchool_Click"
                    Content="Add school" />
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="12,0,12,12"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
