<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.Scenarios.ContinuousRecognitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="900"
            Padding="32,24,32,32"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock
                x:Name="ScenarioTitleTextBlock"
                Style="{StaticResource TitleTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ScenarioDescriptionTextBlock"
                MaxWidth="720"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="RequirementsInfoBar"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />

            <ComboBox
                x:Name="LanguageComboBox"
                MinWidth="260"
                Header="Recognition language"
                SelectionChanged="LanguageComboBox_SelectionChanged" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="StartStopButton"
                    AutomationProperties.Name="Start continuous recognition"
                    Click="StartStopButton_Click"
                    Content="Start continuous recognition"
                    IsEnabled="False" />
                <Button
                    x:Name="ClearButton"
                    Click="ClearButton_Click"
                    Content="Clear text"
                    IsEnabled="False"
                    Visibility="Collapsed" />
            </StackPanel>

            <TextBlock
                x:Name="HelpTextBlock"
                MaxWidth="720"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />

            <Button
                x:Name="PrivacySettingsButton"
                Click="PrivacySettingsButton_Click"
                Content="Open speech privacy settings"
                HorizontalAlignment="Left"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="DictationPanel"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Message dictation" />
                <TextBox
                    x:Name="DictationTextBox"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    MinHeight="160"
                    TextWrapping="Wrap" />
                <InfoBar
                    x:Name="DiscardedResultInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Low-confidence result discarded" />
            </StackPanel>

            <Canvas
                x:Name="ColorPreviewCanvas"
                Width="200"
                Height="200"
                HorizontalAlignment="Left"
                Visibility="Collapsed">
                <Rectangle
                    x:Name="ColorPreviewRectangle"
                    Width="200"
                    Height="200"
                    Fill="Gray"
                    Stroke="White"
                    StrokeThickness="20" />
                <Ellipse
                    x:Name="ColorPreviewCircle"
                    Width="160"
                    Height="160"
                    Canvas.Left="20"
                    Canvas.Top="20"
                    Fill="Black" />
            </Canvas>

            <TextBlock
                x:Name="ResultHeadingTextBlock"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Latest result"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="ResultTextBlock"
                MaxWidth="720"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
