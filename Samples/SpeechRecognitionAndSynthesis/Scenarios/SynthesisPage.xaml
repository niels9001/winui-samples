<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.Scenarios.SynthesisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="900"
            Padding="32,24,32,32"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock
                x:Name="ScenarioTitleTextBlock"
                Style="{StaticResource TitleTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ScenarioDescriptionTextBlock"
                MaxWidth="720"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="Speech playback requires an installed system voice and Windows media components."
                Severity="Informational" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="SpeakButton"
                    AutomationProperties.Name="Speak synthesized text"
                    Click="SpeakButton_Click"
                    Content="Speak" />
                <ComboBox
                    x:Name="VoiceComboBox"
                    MinWidth="320"
                    Header="Voice"
                    SelectionChanged="VoiceComboBox_SelectionChanged" />
            </StackPanel>

            <MediaPlayerElement
                x:Name="PlayerElement"
                AreTransportControlsEnabled="False"
                Visibility="Collapsed" />

            <TextBox
                x:Name="InputTextBox"
                AcceptsReturn="True"
                Header="Text to synthesize"
                MaxWidth="860"
                MinHeight="120"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="BoundaryOptionsPanel"
                Spacing="4"
                Visibility="Collapsed">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Boundary metadata" />
                <CheckBox
                    x:Name="WordBoundariesCheckBox"
                    Content="Report word boundaries"
                    IsChecked="True" />
                <CheckBox
                    x:Name="SentenceBoundariesCheckBox"
                    Content="Report sentence boundaries"
                    IsChecked="True" />
            </StackPanel>

            <StackPanel
                x:Name="BoundaryResultsPanel"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="Collapsed">
                <TextBox
                    x:Name="LastWordTextBox"
                    Header="Last speech word"
                    IsReadOnly="True"
                    MinWidth="240" />
                <TextBox
                    x:Name="LastSentenceTextBox"
                    Header="Last speech sentence"
                    IsReadOnly="True"
                    MinWidth="360" />
            </StackPanel>

            <TextBox
                x:Name="LastMarkTextBox"
                Header="Last SSML mark triggered"
                IsReadOnly="True"
                MinWidth="320"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
