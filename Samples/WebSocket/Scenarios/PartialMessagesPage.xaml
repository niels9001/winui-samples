<Page
    x:Class="SDKTemplate.PartialMessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel
            MaxWidth="900"
            Padding="24"
            HorizontalAlignment="Stretch"
            Spacing="12">
            <TextBlock
                x:Uid="PartialHeading"
                Style="{StaticResource TitleTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Uid="PartialDescription"
                TextWrapping="Wrap" />

            <TextBox
                x:Name="ServerAddressField"
                x:Uid="PartialServerAddress"
                AutomationProperties.AutomationId="PartialServerAddress"
                InputScope="Url" />
            <CheckBox
                x:Name="SecureWebSocketCheckBox"
                x:Uid="PartialSecureWebSocket"
                AutomationProperties.AutomationId="PartialSecureWebSocket"
                Checked="OnSecureEndpointChanged"
                Unchecked="OnSecureEndpointChanged" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="ConnectButton"
                    x:Uid="PartialConnectButton"
                    AutomationProperties.AutomationId="PartialConnectButton"
                    Click="OnConnect"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="DisconnectButton"
                    x:Uid="PartialDisconnectButton"
                    AutomationProperties.AutomationId="PartialDisconnectButton"
                    Click="OnDisconnect" />
            </StackPanel>

            <TextBox
                x:Name="InputField"
                x:Uid="PartialInput"
                AutomationProperties.AutomationId="PartialInput" />
            <CheckBox
                x:Name="EndOfMessageCheckBox"
                x:Uid="PartialEndOfMessage"
                AutomationProperties.AutomationId="PartialEndOfMessage"
                IsChecked="True" />
            <Button
                x:Name="SendButton"
                x:Uid="PartialSendButton"
                AutomationProperties.AutomationId="PartialSendButton"
                HorizontalAlignment="Left"
                Click="OnSend" />

            <TextBlock
                x:Uid="PartialOutputLabel"
                Margin="0,8,0,0" />
            <TextBox
                x:Name="OutputField"
                x:Uid="PartialOutput"
                Height="240"
                AutomationProperties.AutomationId="PartialOutput"
                IsReadOnly="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="Wrap"
                />
        </StackPanel>
    </ScrollViewer>
</Page>
