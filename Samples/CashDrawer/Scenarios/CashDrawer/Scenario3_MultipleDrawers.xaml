<Page
    x:Class="SDKTemplate.Scenario3_MultipleDrawers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Drawer retain and release" />
            <TextBlock
                MaxWidth="720"
                HorizontalAlignment="Left"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Create two objects for the same cash drawer to demonstrate competing claims. When the other instance requests the device, choose whether the current claim should retain it or release it."
                TextWrapping="Wrap" />

            <Grid
                MaxWidth="560"
                HorizontalAlignment="Left"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Instance 1" />
                        <Button
                            x:Name="ClaimButton1"
                            Width="180"
                            Click="ClaimButton1_Click"
                            Content="Claim" />
                        <Button
                            x:Name="ReleaseButton1"
                            Width="180"
                            Click="ReleaseButton1_Click"
                            Content="Release"
                            IsEnabled="False" />
                        <CheckBox
                            x:Name="RetainCheckBox1"
                            Content="Retain device"
                            IsChecked="True" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Instance 2" />
                        <Button
                            x:Name="ClaimButton2"
                            Width="180"
                            Click="ClaimButton2_Click"
                            Content="Claim" />
                        <Button
                            x:Name="ReleaseButton2"
                            Width="180"
                            Click="ReleaseButton2_Click"
                            Content="Release"
                            IsEnabled="False" />
                        <CheckBox
                            x:Name="RetainCheckBox2"
                            Content="Retain device"
                            IsChecked="True" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
