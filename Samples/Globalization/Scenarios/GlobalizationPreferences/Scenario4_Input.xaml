<Page
    x:Class="SDKTemplate.Scenario4_Input"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Margin="24"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Current input language" />
            <TextBlock
                MaxWidth="720"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Read the language tag for the user's current input method. Apps can use this value to tailor text-editing experiences."
                TextWrapping="Wrap" />
            <Button
                Click="ShowResults_Click"
                Content="Show results" />
            <TextBox
                x:Name="OutputTextBox"
                Width="720"
                HorizontalAlignment="Left"
                IsReadOnly="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
