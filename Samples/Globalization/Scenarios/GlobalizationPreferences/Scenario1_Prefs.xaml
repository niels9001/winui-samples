<Page
    x:Class="SDKTemplate.Scenario1_Prefs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Margin="24"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="User preferences" />
            <TextBlock
                MaxWidth="720"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Read the current user's preferred languages, home region, calendars, clocks, and first day of the week. These preferences can differ from the user's physical location."
                TextWrapping="Wrap" />
            <Button
                Click="ShowResults_Click"
                Content="Show results" />
            <TextBox
                x:Name="OutputTextBox"
                Width="720"
                MinHeight="180"
                AcceptsReturn="True"
                HorizontalAlignment="Left"
                IsReadOnly="True"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
