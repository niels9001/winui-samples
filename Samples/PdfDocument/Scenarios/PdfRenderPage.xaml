<Page
    x:Class="SDKTemplate.Scenarios.PdfRenderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                x:Uid="PageTitle"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Uid="PageDescription"
                MaxWidth="900"
                HorizontalAlignment="Left"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="LoadSectionHeading"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <PasswordBox
                        x:Name="PasswordInput"
                        x:Uid="PasswordInput"
                        AutomationProperties.AutomationId="PasswordInput"
                        PasswordRevealMode="Peek" />
                    <Button
                        x:Name="LoadDocumentButton"
                        x:Uid="LoadDocumentButton"
                        AutomationProperties.AutomationId="LoadDocumentButton"
                        Click="LoadDocumentButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock
                        x:Name="SelectedDocumentText"
                        x:Uid="NoDocumentSelectedText"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                x:Name="RenderingPanel"
                Grid.Column="1"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="RenderSectionHeading"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <NumberBox
                            x:Name="PageNumberInput"
                            x:Uid="PageNumberInput"
                            AutomationProperties.AutomationId="PageNumberInput"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Value="1" />
                        <ComboBox
                            x:Name="RenderOptionsComboBox"
                            x:Uid="RenderOptionsComboBox"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="RenderOptionsComboBox"
                            SelectedIndex="0">
                            <ComboBoxItem x:Uid="ActualSizeOption" />
                            <ComboBoxItem x:Uid="HalfSizeOption" />
                            <ComboBoxItem x:Uid="CenterCropOption" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="RenderPageButton"
                            x:Uid="RenderPageButton"
                            AutomationProperties.AutomationId="RenderPageButton"
                            Click="RenderPageButton_Click" />
                        <TextBlock
                            x:Name="PageCountText"
                            x:Uid="PageCountUnavailableText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        x:Uid="RenderedPageHeading"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="RenderDescriptionText"
                        x:Uid="NoPageRenderedText"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <TextBlock
                        x:Name="EmptyStateText"
                        x:Uid="EmptyStateText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <ScrollViewer
                        x:Name="RenderedPageScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <Image
                            x:Name="RenderedPageImage"
                            x:Uid="RenderedPageImage"
                            AutomationProperties.AutomationId="RenderedPageImage"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Stretch="None" />
                    </ScrollViewer>
                    <ProgressRing
                        x:Name="BusyProgressRing"
                        x:Uid="BusyProgressRing"
                        AutomationProperties.AutomationId="BusyProgressRing"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
