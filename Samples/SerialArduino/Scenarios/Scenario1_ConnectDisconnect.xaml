<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SDKTemplate.Scenario1_ConnectDisconnect"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="24"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <TextBlock
                x:Uid="ConnectDisconnectHeading"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Uid="ConnectDisconnectDescription"
                MaxWidth="720"
                HorizontalAlignment="Left"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />

            <StackPanel
                MaxWidth="720"
                HorizontalAlignment="Left"
                Spacing="4">
                <TextBlock
                    x:Uid="SupportedDeviceLabel"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Uid="SupportedDeviceValue"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="SerialSettingsLabel"
                    Margin="0,8,0,0"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Uid="SerialSettingsValue"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid
                MaxWidth="720"
                HorizontalAlignment="Left"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE701;" />
                <TextBlock
                    x:Name="ConnectionStateTextBlock"
                    Grid.Column="1"
                    AutomationProperties.LiveSetting="Polite"
                    TextWrapping="Wrap" />
            </Grid>

            <TextBlock
                x:Uid="AvailableDevicesHeading"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ListView
                x:Name="DevicesListView"
                x:Uid="DevicesListView"
                AutomationProperties.AutomationId="ArduinoDevicesListView"
                Height="260"
                ItemsSource="{x:Bind Devices, Mode=OneWay}"
                SelectionChanged="DevicesListView_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceListEntry">
                        <Grid
                            Padding="4"
                            AutomationProperties.Name="{x:Bind DisplayName}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind DisplayName}" />
                            <TextBlock
                                Grid.Row="1"
                                MaxWidth="640"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind InstanceId}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="SearchingPanel"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    x:Name="DiscoveryProgressRing"
                    x:Uid="DiscoveryProgressRing"
                    Width="18"
                    Height="18"
                    AutomationProperties.AutomationId="ArduinoDiscoveryProgressRing"
                    IsActive="True" />
                <TextBlock
                    x:Uid="SearchingForDevicesText"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                x:Name="EmptyDevicesTextBlock"
                x:Uid="EmptyDevicesTextBlock"
                AutomationProperties.LiveSetting="Polite"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="ConnectButton"
                    x:Uid="ConnectButton"
                    AutomationProperties.AutomationId="ConnectArduinoButton"
                    Click="ConnectButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="DisconnectButton"
                    x:Uid="DisconnectButton"
                    AutomationProperties.AutomationId="DisconnectArduinoButton"
                    Click="DisconnectButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
