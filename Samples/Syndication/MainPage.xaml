<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel
                MaxWidth="960"
                Margin="28"
                HorizontalAlignment="Left"
                Spacing="16">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Retrieve a syndication feed" />
                <TextBlock
                    MaxWidth="720"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Download an RSS or Atom feed with SyndicationClient, inspect its metadata, and browse the returned SyndicationItem objects."
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="FeedUriTextBox"
                    MaxWidth="720"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="FeedUriTextBox"
                    Header="Feed address"
                    InputScope="Url"
                    Text="https://devblogs.microsoft.com/windowsdeveloper/feed/" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        x:Name="GetFeedButton"
                        AutomationProperties.AutomationId="GetFeedButton"
                        Click="GetFeedButton_Click"
                        Content="Get feed"
                        Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing
                        x:Name="DownloadProgressRing"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Downloading feed"
                        IsActive="False"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    x:Name="FeedResultsPanel"
                    Margin="0,12,0,0"
                    Spacing="12"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="FeedTitleTextBlock"
                        AutomationProperties.AutomationId="FeedTitleTextBlock"
                        Style="{StaticResource TitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="FeedSummaryTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            x:Name="PreviousItemButton"
                            AutomationProperties.AutomationId="PreviousItemButton"
                            Click="PreviousItemButton_Click"
                            Content="Previous item" />
                        <TextBlock
                            x:Name="ItemIndexTextBlock"
                            MinWidth="72"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ItemIndexTextBlock"
                            Text="0 of 0"
                            TextAlignment="Center" />
                        <Button
                            x:Name="NextItemButton"
                            AutomationProperties.AutomationId="NextItemButton"
                            Click="NextItemButton_Click"
                            Content="Next item" />
                    </StackPanel>

                    <TextBlock
                        x:Name="ItemTitleTextBlock"
                        AutomationProperties.AutomationId="ItemTitleTextBlock"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        x:Name="ItemLinkButton"
                        MaxWidth="840"
                        Padding="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.AutomationId="ItemLinkButton"
                        Click="ItemLinkButton_Click">
                        <TextBlock
                            x:Name="ItemLinkTextBlock"
                            MaxWidth="840"
                            TextWrapping="Wrap" />
                    </HyperlinkButton>

                    <TextBox
                        x:Name="ItemContentTextBox"
                        MinHeight="220"
                        MaxHeight="360"
                        AcceptsReturn="True"
                        AutomationProperties.AutomationId="ItemContentTextBox"
                        Header="Item content"
                        IsReadOnly="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="ExtensionsHeaderTextBlock"
                        Margin="0,8,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Item extensions" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Node name" />
                        <TextBlock
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="Namespace" />
                        <TextBlock
                            Grid.Column="2"
                            FontWeight="SemiBold"
                            Text="Value" />
                    </Grid>
                    <ListView
                        x:Name="ExtensionsListView"
                        MinHeight="96"
                        MaxHeight="240"
                        AutomationProperties.AutomationId="ExtensionsListView"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="0,6"
                                    ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding NodeName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding NodeName}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding NodeNamespace}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding NodeNamespace}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding NodeValue}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding NodeValue}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="12,0,12,12"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
