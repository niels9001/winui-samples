<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="760"
                Margin="24"
                HorizontalAlignment="Left"
                Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="PageTitle"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="PageDescription"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar
                    x:Uid="TestInstructionsInfoBar"
                    AutomationProperties.AutomationId="TestInstructionsInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="ConnectionHeading"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox
                            x:Name="TargetServerTextBox"
                            x:Uid="TargetServerTextBox"
                            AutomationProperties.AutomationId="TargetServerTextBox"
                            MaxLength="255" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button
                                x:Name="ConnectButton"
                                x:Uid="ConnectButton"
                                AutomationProperties.AutomationId="ConnectButton"
                                Click="ConnectButton_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                            <ProgressRing
                                x:Name="ConnectionProgressRing"
                                x:Uid="ConnectionProgressRing"
                                AutomationProperties.AutomationId="ConnectionProgressRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="ConnectionHint"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            x:Name="StatusInfoBar"
            x:Uid="StatusInfoBar"
            Grid.Row="1"
            Margin="12,0,12,12"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
