<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SDKTemplate.TranscodingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid
            Margin="24"
            HorizontalAlignment="Stretch"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="ScenarioTitleTextBlock"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ScenarioDescriptionTextBlock"
                    MaxWidth="800"
                    HorizontalAlignment="Left"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid
                Grid.Row="1"
                ColumnSpacing="16"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Uid="SourceLabel"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel
                    Grid.Column="1"
                    Spacing="6">
                    <Button
                        x:Name="PickSourceButton"
                        x:Uid="PickSourceButton"
                        AutomationProperties.AutomationId="PickSourceButton"
                        Click="PickSourceButton_Click" />
                    <TextBlock
                        x:Name="SelectedSourceTextBlock"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    x:Uid="TargetFormatLabel"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    x:Name="TargetFormatComboBox"
                    x:Uid="TargetFormatComboBox"
                    AutomationProperties.AutomationId="TargetFormatComboBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    MaxWidth="360"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="TargetFormatComboBox_SelectionChanged">
                    <ComboBoxItem x:Name="Mp4OutputOption" x:Uid="Mp4OutputOption" />
                    <ComboBoxItem x:Name="WmvOutputOption" x:Uid="WmvOutputOption" />
                    <ComboBoxItem x:Name="AviOutputOption" x:Uid="AviOutputOption" />
                </ComboBox>

                <TextBlock
                    x:Name="PresetLabel"
                    x:Uid="PresetLabel"
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    x:Name="PresetComboBox"
                    x:Uid="PresetComboBox"
                    AutomationProperties.AutomationId="PresetComboBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    MaxWidth="360"
                    HorizontalAlignment="Stretch">
                    <ComboBoxItem x:Uid="Preset1080pOption" />
                    <ComboBoxItem x:Uid="Preset720pOption" />
                    <ComboBoxItem x:Uid="PresetWvgaOption" />
                    <ComboBoxItem x:Name="PresetNtscOption" x:Uid="PresetNtscOption" />
                    <ComboBoxItem x:Name="PresetPalOption" x:Uid="PresetPalOption" />
                    <ComboBoxItem x:Uid="PresetVgaOption" />
                    <ComboBoxItem x:Uid="PresetQvgaOption" />
                </ComboBox>

                <CheckBox
                    x:Name="EnableMrfCheckBox"
                    x:Uid="EnableMrfCheckBox"
                    AutomationProperties.AutomationId="EnableMrfCheckBox"
                    Grid.Row="3"
                    Grid.Column="1"
                    MaxWidth="720"
                    HorizontalAlignment="Left" />

                <TextBlock
                    x:Uid="OutputLabel"
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel
                    Grid.Row="4"
                    Grid.Column="1"
                    Spacing="6">
                    <Button
                        x:Name="PickOutputButton"
                        x:Uid="PickOutputButton"
                        AutomationProperties.AutomationId="PickOutputButton"
                        Click="PickOutputButton_Click" />
                    <TextBlock
                        x:Name="SelectedOutputTextBlock"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="CustomSettingsPanel"
                Grid.Row="2"
                ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="VideoSettingsHeading"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="VideoWidthLabel" />
                    <TextBox
                        x:Name="VideoWidthTextBox"
                        x:Uid="VideoWidthTextBox"
                        AutomationProperties.AutomationId="VideoWidthTextBox"
                        InputScope="Number" />
                    <TextBlock x:Uid="VideoHeightLabel" />
                    <TextBox
                        x:Name="VideoHeightTextBox"
                        x:Uid="VideoHeightTextBox"
                        AutomationProperties.AutomationId="VideoHeightTextBox"
                        InputScope="Number" />
                    <TextBlock x:Uid="VideoBitrateLabel" />
                    <TextBox
                        x:Name="VideoBitrateTextBox"
                        x:Uid="VideoBitrateTextBox"
                        AutomationProperties.AutomationId="VideoBitrateTextBox"
                        InputScope="Number" />
                    <TextBlock x:Uid="VideoFrameRateLabel" />
                    <TextBox
                        x:Name="VideoFrameRateTextBox"
                        x:Uid="VideoFrameRateTextBox"
                        AutomationProperties.AutomationId="VideoFrameRateTextBox"
                        InputScope="Number" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Spacing="8">
                    <TextBlock
                        x:Uid="AudioSettingsHeading"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="AudioBitsPerSampleLabel" />
                    <TextBox
                        x:Name="AudioBitsPerSampleTextBox"
                        x:Uid="AudioBitsPerSampleTextBox"
                        AutomationProperties.AutomationId="AudioBitsPerSampleTextBox"
                        InputScope="Number" />
                    <TextBlock x:Uid="AudioSampleRateLabel" />
                    <TextBox
                        x:Name="AudioSampleRateTextBox"
                        x:Uid="AudioSampleRateTextBox"
                        AutomationProperties.AutomationId="AudioSampleRateTextBox"
                        InputScope="Number" />
                    <TextBlock x:Uid="AudioBitrateLabel" />
                    <TextBox
                        x:Name="AudioBitrateTextBox"
                        x:Uid="AudioBitrateTextBox"
                        AutomationProperties.AutomationId="AudioBitrateTextBox"
                        InputScope="Number" />
                    <TextBlock x:Uid="AudioChannelCountLabel" />
                    <TextBox
                        x:Name="AudioChannelCountTextBox"
                        x:Uid="AudioChannelCountTextBox"
                        AutomationProperties.AutomationId="AudioChannelCountTextBox"
                        InputScope="Number" />
                </StackPanel>
            </Grid>

            <StackPanel
                x:Name="TrimSettingsPanel"
                Grid.Row="3"
                Spacing="12">
                <TextBlock
                    x:Uid="TrimSettingsHeading"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="TrimStartLabel" />
                        <TextBlock
                            x:Name="TrimStartTextBlock"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button
                            x:Name="MarkInButton"
                            x:Uid="MarkInButton"
                            AutomationProperties.AutomationId="MarkInButton"
                            Click="MarkInButton_Click" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="6">
                        <TextBlock x:Uid="TrimEndLabel" />
                        <TextBlock
                            x:Name="TrimEndTextBlock"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button
                            x:Name="MarkOutButton"
                            x:Uid="MarkOutButton"
                            AutomationProperties.AutomationId="MarkOutButton"
                            Click="MarkOutButton_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel
                Grid.Row="4"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="TranscodeButton"
                    x:Uid="TranscodeButton"
                    AutomationProperties.AutomationId="TranscodeButton"
                    Click="TranscodeButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="CancelButton"
                    x:Uid="CancelButton"
                    AutomationProperties.AutomationId="CancelTranscodeButton"
                    Click="CancelButton_Click" />
            </StackPanel>

            <StackPanel
                x:Name="ProgressPanel"
                Grid.Row="5"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ProgressTextBlock"
                    x:Uid="ProgressIdleText"
                    TextWrapping="Wrap" />
                <ProgressBar
                    x:Name="TranscodeProgressBar"
                    x:Uid="TranscodeProgressBar"
                    AutomationProperties.AutomationId="TranscodeProgressBar"
                    Maximum="100"
                    Minimum="0" />
            </StackPanel>

            <Grid
                x:Name="PreviewGrid"
                Grid.Row="6"
                ColumnSpacing="20"
                RowSpacing="20">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState>
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1050" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="InputPreviewPanel.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="OutputPreviewPanel.(Grid.Row)" Value="0" />
                                <Setter Target="OutputPreviewPanel.(Grid.Column)" Value="1" />
                                <Setter Target="OutputPreviewPanel.(Grid.ColumnSpan)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="InputPreviewPanel"
                    Grid.ColumnSpan="2"
                    Spacing="8">
                    <TextBlock
                        x:Uid="InputPreviewHeading"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <MediaPlayerElement
                            x:Name="InputPlayerElement"
                            x:Uid="InputPlayerElement"
                            AutomationProperties.AutomationId="InputMediaPlayer"
                            Height="300"
                            AreTransportControlsEnabled="True"
                            AutoPlay="False"
                            Stretch="Uniform" />
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="OutputPreviewPanel"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Spacing="8">
                    <TextBlock
                        x:Uid="OutputPreviewHeading"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="OutputPathTextBlock"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <Border
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <MediaPlayerElement
                            x:Name="OutputPlayerElement"
                            x:Uid="OutputPlayerElement"
                            AutomationProperties.AutomationId="OutputMediaPlayer"
                            Height="300"
                            AreTransportControlsEnabled="True"
                            AutoPlay="False"
                            Stretch="Uniform" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
