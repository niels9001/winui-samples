<Page
    x:Class="SDKTemplate.ListFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="24,24,24,12"
            Spacing="12">
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="List Pictures library folders" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Get the current Pictures library definition and monitor it for changes made by this or another app."
                TextWrapping="Wrap" />
            <Button
                x:Name="ListFoldersButton"
                HorizontalAlignment="Left"
                Click="ListFoldersButton_Click"
                Content="List folders" />
            <TextBlock
                x:Name="FoldersHeader"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>

        <ListView
            x:Name="FoldersList"
            Grid.Row="1"
            Margin="24,0,24,24"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{Binding DisplayName}" />
                        <TextBlock
                            Opacity="0.7"
                            Text="{Binding Path}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
