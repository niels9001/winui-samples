<Page
    x:Class="SDKTemplate.AddFolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Margin="24"
            MaxWidth="720"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Add a folder to the Pictures library" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Request a folder from the system library picker and add the approved folder to the Pictures library definition."
                TextWrapping="Wrap" />
            <Button
                x:Name="AddFolderButton"
                HorizontalAlignment="Left"
                Click="AddFolderButton_Click"
                Content="Add folder" />
            <TextBlock
                x:Name="OutputText"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
