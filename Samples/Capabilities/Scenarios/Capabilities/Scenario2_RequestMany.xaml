<Page
    x:Class="SDKTemplate.Scenario2_RequestMany"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Margin="24"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Request multiple capabilities" />
            <TextBlock
                MaxWidth="720"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="An app can request access to multiple declared capabilities in one operation. This example requests location and webcam access and reports the status of each request."
                TextWrapping="Wrap" />
            <Button
                x:Name="RequestAccessButton"
                Click="RequestAccessButton_Click"
                Content="Request location and camera access" />
        </StackPanel>
    </ScrollViewer>
</Page>
