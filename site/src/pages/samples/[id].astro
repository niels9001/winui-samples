---
import { OpenRegular } from "@fluentui/react-icons/svg/open";
import type { GetStaticPaths } from "astro";

import ApiList from "../../components/ApiList.astro";
import AppShell from "../../components/AppShell.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import CodeBrowser from "../../components/CodeBrowser.astro";
import FederatedContent from "../../components/FederatedContent.astro";
import RelatedSamples from "../../components/RelatedSamples.astro";
import SampleMedia from "../../components/SampleMedia.astro";
import ScenarioList from "../../components/ScenarioList.astro";
import type { CatalogSample } from "../../lib/catalog";
import { categoryById } from "../../lib/catalog";
import { catalog } from "../../lib/catalog-data";
import { getDetailRouteDefinitions } from "../../lib/detail-routes";
import {
  describeFeaturedFiles,
  readFeaturedFile,
} from "../../lib/featured-files";
import { readSampleReadmeContext } from "../../lib/readme-context";
import { getRelatedSamples } from "../../lib/related-samples";
import {
  resolveHeroMedia,
  resolvePrimaryIconMedia,
} from "../../lib/sample-media";
import {
  developerDocumentation,
  getSampleSource,
} from "../../lib/source-provenance";
import {
  repositoryBlobUrl,
  sitePath,
} from "../../lib/urls";

type Props =
  | {
      kind: "sample";
      sample: CatalogSample;
    }
  | {
      kind: "redirect";
      redirectTo: string;
    };

export const getStaticPaths = (() =>
  getDetailRouteDefinitions(catalog).map((route) => ({
    params: { id: route.id },
    props:
      route.kind === "sample"
        ? { kind: "sample", sample: route.sample }
        : { kind: "redirect", redirectTo: route.redirectTo },
  }))) satisfies GetStaticPaths;

if (Astro.props.kind === "redirect") {
  return Astro.redirect(
    sitePath(`/samples/${Astro.props.redirectTo}/`),
    301,
  );
}
const { sample } = Astro.props;
const categories = categoryById(catalog);
const primaryCategory = categories.get(sample.categories.primary);
const hero = await resolveHeroMedia(sample);
const icon = await resolvePrimaryIconMedia(sample);
const readme = sample.federated
  ? { limitations: undefined }
  : await readSampleReadmeContext(sample);
const related = getRelatedSamples(sample, catalog);
const featuredFiles = describeFeaturedFiles(sample);
const firstFeaturedFile =
  featuredFiles.find((file) => file.routePath !== null) ??
  featuredFiles[0];
const featuredPreview = firstFeaturedFile
  ? await readFeaturedFile(sample, firstFeaturedFile)
  : undefined;
const source = getSampleSource(sample);
const documentation = developerDocumentation(sample);
const record = sample.federated?.record;
const isExternal = Boolean(record);
const projectPath = `${sample.project.repositoryPath}/${sample.project.name}.csproj`
  .replaceAll("/", "\\");
const buildCommands = `dotnet build .\\${projectPath} -c Debug -p:Platform=x64
dotnet run --project .\\${projectPath} -c Debug -p:Platform=x64`;
const requirementHighlights = [
  sample.requirements.hardware.length > 0
    ? sample.requirements.hardware.join(", ")
    : undefined,
  sample.requirements.accountServices.length > 0
    ? sample.requirements.accountServices.join(", ")
    : undefined,
]
  .filter((value) => value !== undefined)
  .map((value) => value.replace(/[.!?]+$/, ""));
const contentGroups = record
  ? [
      ["variants", record.content.variants.length],
      ["scenarios", record.content.scenarios.length],
      ["examples", record.content.examples.length],
    ].filter(([, count]) => Number(count) > 0)
  : [["scenarios", sample.scenarios.length]];
const contentCount = contentGroups.reduce(
  (total, [, count]) => total + Number(count),
  0,
);
const singleContentGroup =
  contentGroups.length === 1 ? contentGroups[0] : undefined;
const contentLabel =
  singleContentGroup
    ? String(singleContentGroup[0])
    : "nested items";
const limitations = record?.limitations ?? [];
const localLimitation = readme.limitations;
const showRun = !isExternal;
const showContent = contentCount > 0;
const showApis = sample.apis.length > 0;
const showCode = featuredFiles.length > 0;
const minimumWindowsVersion =
  sample.requirements.minimumWindowsVersion ?? "Not specified upstream";
const architectureLabel =
  sample.requirements.supportedArchitectures.length > 0
    ? sample.requirements.supportedArchitectures.join(" / ")
    : "Not specified upstream";
---

<AppShell
  title={sample.title}
  description={sample.summary ?? sample.title}
  activeNav="samples"
>
  <section class="detail-hero" id="overview" aria-labelledby="detail-title">
    <div class="site-container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href={sitePath("/")}>Home</a></li>
          <li><a href={sitePath("/samples/")}>Browse</a></li>
          <li aria-current="page">{sample.project.name}</li>
        </ol>
      </nav>
      <div
        class:list={[
          "detail-hero-grid",
          { "detail-hero-grid--media": Boolean(hero) },
        ]}
      >
        <div class="stack detail-heading">
          <a class="source-label" href={source.canonicalUrl}>
            {source.label}
          </a>
          <div class="detail-category">
            <span>{primaryCategory?.label ?? sample.categories.primary}</span>
            <span aria-hidden="true">·</span>
            <code>{sample.project.name}</code>
          </div>
          <div class="detail-title-row">
            {
              icon && (
                <img
                  alt=""
                  aria-hidden="true"
                  class="detail-title-icon"
                  height={icon.height ?? 72}
                  src={sitePath(icon.routePath)}
                  width={icon.width ?? 72}
                />
              )
            }
            <h1 id="detail-title">{sample.title}</h1>
          </div>
          {sample.summary && <p class="detail-summary">{sample.summary}</p>}
          {
            record?.description &&
              record.description !== sample.summary && (
                <p class="detail-description">{record.description}</p>
              )
          }
          <dl class="hero-requirements">
            <div>
              <dt>Windows</dt>
              <dd>{minimumWindowsVersion}</dd>
            </div>
            <div>
              <dt>Architectures</dt>
              <dd>{architectureLabel}</dd>
            </div>
            <div>
              <dt>{contentLabel}</dt>
              <dd>{contentCount}</dd>
            </div>
          </dl>
          {
            requirementHighlights.length > 0 && (
              <p class="requirement-highlight">
                <strong>Additional setup</strong>
                {requirementHighlights.join(" · ")}
              </p>
            )
          }
          <div class="detail-actions">
            <a class="button-link" href={source.canonicalUrl}>
              View source <OpenRegular aria-hidden="true" />
            </a>
            {
              sample.federated?.appDeepLink && (
                <a class="secondary-button-link" href={sample.federated.appDeepLink}>
                  Open in WinUI Gallery
                </a>
              )
            }
          </div>
        </div>
        <div class="detail-preview" data-pointer-surface data-tilt>
          <SampleMedia
            category={primaryCategory}
            eager
            hero={hero}
            sample={sample}
          />
        </div>
      </div>
      {
        sample.tags.length > 0 && (
          <p class="topic-line">
            <strong>Topics</strong>
            {sample.tags.join(" · ")}
          </p>
        )
      }
    </div>
  </section>

  <div class="site-container detail-layout">
    <aside class="page-index surface" aria-labelledby="page-index-title">
      <strong id="page-index-title">On this page</strong>
      <nav aria-labelledby="page-index-title">
        <a href="#overview">Overview</a>
        {showRun && <a href="#run">Run</a>}
        {showContent && <a href="#content">Scenarios and examples</a>}
        {showApis && <a href="#apis">Key APIs</a>}
        {showCode && <a href="#code">Code</a>}
        <a href="#requirements">Requirements</a>
        <a href="#limitations">Limitations</a>
        <a href="#resources">Source and docs</a>
      </nav>
    </aside>

    <div class="stack detail-main" aria-label="Project documentation">
      {
        showRun && (
          <section
            class="stack detail-section run-section"
            id="run"
            aria-labelledby="run-title"
            data-scroll-reveal
          >
            <div class="stack section-copy">
              <p class="eyebrow">Run this project</p>
              <h2 id="run-title">Build and launch from a local checkout</h2>
              <p class="secondary-text">
                Run these commands at the root of <strong>{source.label}</strong>{" "}
                on Windows. The packaged launcher may detach after the app opens.
              </p>
            </div>
            <CodeBlock
              code={buildCommands}
              label={`PowerShell · ${sample.project.name}`}
              copyLabel={`Copy ${sample.project.name} build commands`}
            />
          </section>
        )
      }

      {
        showContent && (
          <section
            class="stack detail-section"
            id="content"
            aria-labelledby="content-title"
            data-scroll-reveal
          >
            <div class="stack section-copy">
              <p class="eyebrow">What it covers</p>
              <h2 id="content-title">Scenarios and examples</h2>
              <p class="secondary-text">
                Behaviors and implementation choices stay grouped under the
                developer-facing sample that owns them.
              </p>
            </div>
            {record ? (
              <FederatedContent sample={sample} />
            ) : (
              <ScenarioList sample={sample} />
            )}
          </section>
        )
      }

      {
        showApis && (
          <section
            class="stack detail-section"
            id="apis"
            aria-labelledby="apis-title"
            data-scroll-reveal
          >
            <div class="stack section-copy">
              <p class="eyebrow">Platform surface</p>
              <h2 id="apis-title">Key APIs</h2>
            </div>
            <ApiList apis={sample.apis} />
          </section>
        )
      }

      {showCode && <section
        class="stack detail-section code-section"
        id="code"
        aria-labelledby="code-section-title"
        data-scroll-reveal
      >
        <div class="stack section-copy">
          <p class="eyebrow">Implementation</p>
          <h2 id="code-section-title">Read the code</h2>
          <p class="secondary-text">
            Move between the curated files without loading the entire project
            into this page.
          </p>
        </div>
        {
          featuredPreview ? (
            <CodeBrowser
              activeFile={featuredPreview}
              files={featuredFiles}
              sample={sample}
            />
          ) : (
            <div class="surface code-empty">
              <h3>No curated preview is available</h3>
              <p>Open the canonical source to inspect the full project.</p>
              <a href={source.canonicalUrl}>View source</a>
            </div>
          )
        }
      </section>}

      <section
        class="stack detail-section"
        id="requirements"
        aria-labelledby="requirements-title"
        data-scroll-reveal
      >
        <div class="stack section-copy">
          <p class="eyebrow">Before you run it</p>
          <h2 id="requirements-title">Requirements</h2>
        </div>
        <div class="requirements-grid">
          <article class="surface requirement-card stack">
            <h3>Platform</h3>
            <dl>
              <div>
                <dt>Minimum Windows version</dt>
                <dd>{minimumWindowsVersion}</dd>
              </div>
              <div>
                <dt>Architectures</dt>
                <dd>
                  {architectureLabel}
                </dd>
              </div>
            </dl>
            {
              sample.requirements.architectureNotes && (
                <p>{sample.requirements.architectureNotes}</p>
              )
            }
          </article>
          <article class="surface requirement-card stack">
            <h3>Hardware and services</h3>
            <dl>
              <div>
                <dt>Hardware</dt>
                <dd>
                  {
                    sample.requirements.hardware.length > 0
                      ? sample.requirements.hardware.join(", ")
                      : "No additional hardware"
                  }
                </dd>
              </div>
              <div>
                <dt>Accounts and services</dt>
                <dd>
                  {
                    sample.requirements.accountServices.length > 0
                      ? sample.requirements.accountServices.join(", ")
                      : "No additional account or service"
                  }
                </dd>
              </div>
            </dl>
          </article>
          <article class="surface requirement-card capability-card stack">
            <h3>Package capabilities</h3>
            {
              sample.requirements.capabilities.length > 0 ? (
                <ul>
                  {sample.requirements.capabilities.map((capability) => (
                    <li>
                      <span>
                        <code>{capability.name}</code>
                        <small>{capability.kind}</small>
                      </span>
                      <p>{capability.description}</p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>No additional package capabilities are declared.</p>
              )
            }
          </article>
          {
            ((sample.requirements.software?.length ?? 0) > 0 ||
              (sample.requirements.notes?.length ?? 0) > 0 ||
              (record?.categories.provider.length ?? 0) > 0) && (
              <article class="surface requirement-card stack">
                <h3>Environment</h3>
                {sample.requirements.software &&
                  sample.requirements.software.length > 0 && (
                    <>
                      <strong>Software</strong>
                      <ul>
                        {sample.requirements.software.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </>
                  )}
                {sample.requirements.notes &&
                  sample.requirements.notes.length > 0 && (
                    <>
                      <strong>Notes</strong>
                      <ul>
                        {sample.requirements.notes.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </>
                  )}
                {record && record.categories.provider.length > 0 && (
                  <p>
                    <strong>Source category</strong>{" "}
                    {record.categories.provider.join(" · ")}
                  </p>
                )}
              </article>
            )
          }
        </div>
      </section>

      <section
        class="stack detail-section"
        id="limitations"
        aria-labelledby="limitations-title"
        data-scroll-reveal
      >
        <div class="stack section-copy">
          <p class="eyebrow">Plan around</p>
          <h2 id="limitations-title">Limitations</h2>
        </div>
        <div class="surface limitations-note">
          {
            limitations.length > 0 ? (
              <ul>
                {limitations.map((limitation) => <li>{limitation}</li>)}
              </ul>
            ) : (
              <p>
                {localLimitation ??
                  "No runtime or platform limitations are documented."}
              </p>
            )
          }
        </div>
      </section>

      <section
        class="stack detail-section"
        id="resources"
        aria-labelledby="resources-title"
        data-scroll-reveal
      >
        <div class="stack section-copy">
          <p class="eyebrow">Go deeper</p>
          <h2 id="resources-title">Source and documentation</h2>
        </div>
        <div class="resource-grid">
          <article class="surface resource-card stack">
            <h3>Current source</h3>
            <a class="source-label" href={source.canonicalUrl}>
              {source.label}
            </a>
            <ul>
              <li><a href={source.canonicalUrl}>Pinned source</a></li>
              {
                record ? (
                  <>
                    <li><a href={record.links.repository}>Repository</a></li>
                    <li>
                      <a href={record.links.commit}>
                        Commit {record.source.lockedCommitSha.slice(0, 12)}
                      </a>
                    </li>
                  </>
                ) : (
                  <li>
                    <a href={repositoryBlobUrl(
                      sample.project.repositoryPath,
                      `${sample.project.name}.csproj`,
                    )}>
                      Project file
                    </a>
                  </li>
                )
              }
            </ul>
          </article>
          <article class="surface resource-card stack">
            <h3>Documentation</h3>
            {
              documentation.length > 0 ? (
                <ul>
                  {documentation.map((document) => (
                    <li>
                      <a href={document.url}>{document.title}</a>
                      <span>{document.kind.replaceAll("-", " ")}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>No additional documentation is linked.</p>
              )
            }
          </article>
          {
            sample.originalSamples.length > 0 && (
              <article class="surface resource-card stack">
                <h3>Reference implementations</h3>
                <ul>
                  {sample.originalSamples.map((original) => (
                    <li>
                      <a href={original.url}>{original.name}</a>
                      <span>Windows reference</span>
                    </li>
                  ))}
                </ul>
              </article>
            )
          }
          {
            sample.federated && (
              <article class="surface resource-card stack">
                <h3>License and attribution</h3>
                <ul>
                  {sample.federated.licenses.map((license) => (
                    <li>
                      <a href={license.licenseUrl}>{license.spdxId}</a>
                      <span>
                        {license.scopePath
                          ? `Applies to ${license.scopePath}`
                          : "Repository license"}
                      </span>
                      {license.attributionText && (
                        <small>{license.attributionText}</small>
                      )}
                    </li>
                  ))}
                </ul>
              </article>
            )
          }
        </div>
      </section>

      <RelatedSamples categories={catalog.categories} related={related} />
    </div>
  </div>
</AppShell>

<style>
  .detail-hero {
    scroll-margin-top: 5rem;
    padding-block: var(--site-space-5) clamp(3.5rem, 6vw, 5.5rem);
    border-bottom: 1px solid var(--site-color-border-subtle);
    background:
      radial-gradient(circle at 88% 10%, var(--site-color-brand-subtle), transparent 30rem),
      color-mix(in srgb, var(--site-color-canvas-subtle) 82%, transparent);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--site-space-2);
    padding: 0;
    color: var(--site-color-text-muted);
    font-size: 0.78rem;
    list-style: none;
  }

  .breadcrumb li:not(:last-child)::after {
    margin-left: var(--site-space-2);
    content: "/";
  }

  .detail-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(24rem, 0.98fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .detail-hero-grid--media {
    grid-template-columns: minmax(0, 0.9fr) minmax(28rem, 1.1fr);
    gap: clamp(3rem, 6vw, 6rem);
  }

  .detail-heading {
    --stack-space: var(--site-space-4);
    min-width: 0;
  }

  .detail-category {
    display: flex;
    flex-wrap: wrap;
    gap: var(--site-space-2);
    color: var(--site-color-text-muted);
    font-size: 0.78rem;
  }

  .detail-category code {
    color: inherit;
  }

  .detail-heading h1 {
    max-width: 16ch;
    font-size: clamp(2.65rem, 5vw, 4.7rem);
    letter-spacing: -0.055em;
  }

  .detail-title-row {
    display: flex;
    align-items: center;
    gap: var(--site-space-4);
  }

  .detail-title-icon {
    width: clamp(3rem, 7vw, 4.5rem);
    height: clamp(3rem, 7vw, 4.5rem);
    flex: 0 0 auto;
    object-fit: contain;
  }

  .detail-summary,
  .detail-description {
    max-width: var(--site-reading-width);
    color: var(--site-color-text-secondary);
  }

  .detail-summary {
    font-size: clamp(1.04rem, 1.8vw, 1.22rem);
  }

  .detail-description {
    font-size: 0.98rem;
  }

  .hero-requirements {
    display: flex;
    flex-wrap: wrap;
    gap: var(--site-space-4) var(--site-space-6);
    padding-block: var(--site-space-4);
    border-block: 1px solid var(--site-color-border-subtle);
  }

  .hero-requirements div {
    display: grid;
    gap: var(--site-space-1);
  }

  .hero-requirements dt {
    color: var(--site-color-text-muted);
    font-size: 0.68rem;
    font-weight: 680;
    text-transform: uppercase;
  }

  .hero-requirements dd {
    margin: 0;
    color: var(--site-color-text);
    font-size: 0.86rem;
    font-weight: 620;
  }

  .requirement-highlight {
    color: var(--site-color-text-secondary);
    font-size: 0.86rem;
  }

  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--site-space-4);
  }

  .secondary-button-link {
    color: var(--site-color-text-secondary);
    font-size: 0.86rem;
    font-weight: 680;
    text-decoration: none;
  }

  .detail-preview {
    border-radius: calc(var(--site-radius-large) + 4px);
  }

  .detail-preview :global(.detail-visual) {
    box-shadow: var(--site-shadow-window);
  }

  .topic-line {
    max-width: 60rem;
    margin-top: var(--site-space-6);
    color: var(--site-color-text-muted);
    font-size: 0.78rem;
  }

  .topic-line strong {
    margin-right: var(--site-space-3);
    color: var(--site-color-text-secondary);
  }

  .detail-layout {
    display: grid;
    grid-template-columns: minmax(11rem, 14rem) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: var(--site-space-8);
  }

  .page-index {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: var(--site-space-4);
    padding: var(--site-space-5);
    box-shadow: none;
  }

  .page-index > strong {
    font-size: 0.82rem;
  }

  .page-index nav {
    display: grid;
    gap: var(--site-space-1);
  }

  .page-index a {
    padding: 0.35rem 0.5rem;
    border-radius: var(--site-radius-small);
    color: var(--site-color-text-secondary);
    font-size: 0.78rem;
    font-weight: 620;
    text-decoration: none;
  }

  .page-index a:hover {
    background: var(--site-color-surface-hover);
    color: var(--site-color-text);
  }

  .detail-main {
    --stack-space: var(--site-space-9);
    min-width: 0;
  }

  .detail-section {
    --stack-space: var(--site-space-5);
    min-width: 0;
    scroll-margin-top: 6rem;
  }

  .section-copy {
    --stack-space: var(--site-space-3);
    max-width: var(--site-reading-width);
  }

  .run-section {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--site-color-border-subtle);
    border-radius: var(--site-radius-xlarge);
    background:
      radial-gradient(circle at 90% 0%, var(--site-color-brand-subtle), transparent 22rem),
      var(--site-color-surface);
  }

  .code-empty {
    display: grid;
    justify-items: start;
    gap: var(--site-space-2);
    padding: var(--site-space-5);
    box-shadow: none;
  }

  .requirements-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--site-space-4);
  }

  .requirement-card {
    --stack-space: var(--site-space-4);
    padding: var(--site-space-5);
    box-shadow: none;
  }

  .requirement-card h3 {
    font-size: 1.15rem;
  }

  .requirement-card dl {
    display: grid;
    gap: var(--site-space-3);
  }

  .requirement-card dl div {
    display: grid;
    gap: var(--site-space-1);
  }

  .requirement-card dt,
  .capability-card small {
    color: var(--site-color-text-muted);
    font-size: 0.7rem;
    font-weight: 680;
    text-transform: uppercase;
  }

  .requirement-card dd {
    margin: 0;
    font-size: 0.88rem;
  }

  .requirement-card > p,
  .capability-card li p {
    color: var(--site-color-text-secondary);
    font-size: 0.82rem;
  }

  .capability-card {
    grid-column: 1 / -1;
  }

  .capability-card ul {
