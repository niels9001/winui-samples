---
import AppShell from "../../components/AppShell.astro";
import { SampleExplorer } from "../../components/SampleExplorer";
import { getBrowseIndexArtifact } from "../../lib/browse-index";
import { catalog } from "../../lib/catalog-data";
import { productName } from "../../lib/site-metadata";
import { sitePath } from "../../lib/urls";

if (!catalog.searchIndex) {
  throw new Error("The generated Browse search projection is missing.");
}
const browseIndex = await getBrowseIndexArtifact();
const categoryById = new Map(
  catalog.categories.map((category) => [category.id, category]),
);
const providerOrder = new Map([
  ["winui-samples", 0],
  ["winui-gallery", 1],
  ["windows-app-sdk-samples", 2],
]);
const portalProviders = [...(catalog.providers ?? [])].sort(
  (left, right) =>
    (providerOrder.get(left.id) ?? 99) -
    (providerOrder.get(right.id) ?? 99),
);
---

<AppShell
  title="Browse"
  description="Search working WinUI and Windows App SDK examples by outcome, API, source, and requirement."
  activeNav="samples"
>
  <section class="page-intro">
    <div class="site-container intro-layout">
      <div class="stack intro-content">
        <p class="eyebrow">Browse</p>
        <h1>Find code by outcome, API, or requirement</h1>
        <p>
          Search all {catalog.samples.length} examples, then narrow by source,
          category, language, hardware, capability, or architecture.
        </p>
      </div>
      <div class="source-summary surface">
        <strong>Three trusted sources</strong>
        <ul>
          {
            portalProviders.map((provider) => (
              <li>
                <span>{provider.label}</span>
                <span>{provider.recordCount}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section browse-section" aria-labelledby="catalog-title">
    <div class="site-container stack catalog-layout">
      <h2 class="visually-hidden" id="catalog-title">Windows code results</h2>
      <SampleExplorer
        basePath={import.meta.env.BASE_URL}
        client:only="react"
        expectedCatalogHash={catalog.contentHash ?? ""}
        expectedIndexHash={catalog.searchIndex.contentHash}
        expectedRecordCount={catalog.samples.length}
        indexIntegrity={browseIndex.integrity}
        indexUrl={sitePath(`/browse-index/${browseIndex.filename}`)}
      >
        <div class="explorer-loading surface" slot="fallback">
          Loading the sample index…
        </div>
      </SampleExplorer>
      <noscript>
        <section class="noscript-directory surface" aria-labelledby="static-title">
          <div>
            <p class="eyebrow">Static directory</p>
            <h2 id="static-title">Open an example directly</h2>
            <p>
              Search and filters need JavaScript. Every sample in {productName}{" "}
              remains available below.
            </p>
          </div>
          <ul>
            {
              catalog.samples.map((sample) => (
                <li>
                  <a href={sitePath(`/samples/${sample.id}/`)}>
                    <strong>{sample.title}</strong>
                    <span>
                      {categoryById.get(sample.categories.primary)?.label ??
                        sample.categories.primary}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </noscript>
    </div>
  </section>
</AppShell>

<style>
  .page-intro {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--site-color-border-subtle);
    background:
      radial-gradient(circle at 88% 10%, var(--site-color-brand-subtle), transparent 28rem),
      color-mix(in srgb, var(--site-color-canvas-subtle) 82%, transparent);
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--site-space-7);
  }

  .intro-content {
    --stack-space: var(--site-space-3);
    max-width: 52rem;
  }

  .intro-content h1 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
  }

  .intro-content > p:last-child {
    max-width: 42rem;
    color: var(--site-color-text-secondary);
    font-size: 1.02rem;
  }

  .source-summary {
    display: grid;
    min-width: 17rem;
    gap: var(--site-space-3);
    padding: var(--site-space-4);
    box-shadow: none;
  }

  .source-summary > strong {
    font-size: 0.78rem;
  }

  .source-summary ul {
    display: grid;
    gap: var(--site-space-1);
    padding: 0;
    list-style: none;
  }

  .source-summary li {
    display: flex;
    justify-content: space-between;
    gap: var(--site-space-5);
    color: var(--site-color-text-muted);
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
  }

  .browse-section {
    padding-top: var(--site-space-7);
  }

  .catalog-layout {
    --stack-space: var(--site-space-6);
  }

  .explorer-loading {
    min-height: 24rem;
    padding: var(--site-space-6);
    color: var(--site-color-text-secondary);
  }

  .noscript-directory {
    display: grid;
    gap: var(--site-space-6);
    padding: var(--site-space-6);
  }

  .noscript-directory > div {
    display: grid;
    max-width: 42rem;
    gap: var(--site-space-2);
  }

  .noscript-directory > div p:last-child {
    color: var(--site-color-text-secondary);
  }

  .noscript-directory ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--site-space-2);
    padding: 0;
    list-style: none;
  }

  .noscript-directory a {
    display: grid;
    gap: var(--site-space-1);
    padding: var(--site-space-3);
    border: 1px solid var(--site-color-border-subtle);
    border-radius: var(--site-radius-medium);
    color: var(--site-color-text);
    text-decoration: none;
  }

  .noscript-directory a span {
    color: var(--site-color-text-muted);
    font-size: 0.74rem;
  }

  @media (max-width: 46rem) {
    .intro-layout {
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--site-space-5);
    }

    .source-summary {
      width: 100%;
      min-width: 0;
    }

    .noscript-directory ul {
      grid-template-columns: 1fr;
    }
  }
</style>
