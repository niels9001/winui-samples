---
import AppShell from "../../components/AppShell.astro";
import CoverageNotice from "../../components/CoverageNotice.astro";
import { SampleExplorer } from "../../components/SampleExplorer";
import type { ExplorerSamplePresentation } from "../../components/SampleExplorer";
import { catalog } from "../../lib/catalog-data";
import { resolveHeroMedia } from "../../lib/sample-media";
import { sitePath } from "../../lib/urls";

const samples: ExplorerSamplePresentation[] = await Promise.all(
  catalog.samples.map(async (sample) => {
    const hero = await resolveHeroMedia(sample);
    return {
      sample,
      heroUrl: hero ? sitePath(hero.routePath) : undefined,
      heroAlt: sample.screenshots[0]?.alt,
    };
  }),
);
---

<AppShell
  title="Browse Windows app samples"
  description="Browse metadata-backed WinUI 3 and Windows App SDK samples by the experience they help you build."
  activeNav="samples"
>
  <section class="page-intro">
    <div class="site-container stack intro-content">
      <p class="eyebrow">Browse samples</p>
      <h1>Find the Windows experience you want to build</h1>
      <p>
        Search by the outcome, API, scenario, project, or topic. Filter on
        authored categories and real package or environment requirements
        without turning manifest declarations into feature claims.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="catalog-title">
    <div class="site-container stack catalog-layout">
      <CoverageNotice coverage={catalog.coverage} />
      <h2 class="visually-hidden" id="catalog-title">Published samples</h2>
      <p class="visually-hidden" aria-live="polite" aria-atomic="true"></p>
      <p class="visually-hidden">
        Available facets include primary and secondary categories, topics,
        Declared package capabilities, actual prerequisites, architectures,
        and screenshot capture readiness.
      </p>
      <SampleExplorer
        basePath={import.meta.env.BASE_URL}
        categories={catalog.categories}
        client:only="react"
        samples={samples}
      />
      <noscript>
        <p class="noscript-notice">
          Enable JavaScript to search and filter the catalog. Every published
          sample remains available from its direct URL.
        </p>
      </noscript>
    </div>
  </section>
</AppShell>

<style>
  .page-intro {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-bottom: 1px solid var(--site-color-border-subtle);
    background: var(--site-color-canvas-subtle);
  }

  .intro-content {
    --stack-space: var(--site-space-4);
    max-width: 58rem;
    margin-inline: 0;
  }

  .intro-content h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }

  .intro-content > p:last-child {
    max-width: var(--site-reading-width);
    color: var(--site-color-text-secondary);
    font-size: 1.08rem;
  }

  .catalog-layout {
    --stack-space: var(--site-space-6);
  }

  .noscript-notice {
    padding: var(--site-space-4);
    border: 1px solid var(--site-color-border-subtle);
    border-radius: var(--site-radius-medium);
    color: var(--site-color-text-secondary);
  }

</style>
