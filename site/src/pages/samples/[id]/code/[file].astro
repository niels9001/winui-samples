---
import type { GetStaticPaths } from "astro";

import AppShell from "../../../../components/AppShell.astro";
import CodeBrowser from "../../../../components/CodeBrowser.astro";
import type { CatalogSample } from "../../../../lib/catalog";
import { catalog } from "../../../../lib/catalog-data";
import {
  describeFeaturedFiles,
  readFeaturedFile,
} from "../../../../lib/featured-files";
import type { FeaturedFileDescriptor } from "../../../../lib/featured-files";
import { getSampleSource } from "../../../../lib/source-provenance";
import {
  sampleDetailPath,
  sitePath,
} from "../../../../lib/urls";

interface Props {
  sample: CatalogSample;
  file: FeaturedFileDescriptor;
}

export const getStaticPaths = (() =>
  catalog.samples.flatMap((sample) =>
    describeFeaturedFiles(sample)
      .filter((file) => file.routePath !== null)
      .map((file) => ({
        params: {
          id: sample.id,
          file: file.key,
        },
        props: { sample, file },
      })),
  )) satisfies GetStaticPaths;

const { sample, file } = Astro.props;
const files = describeFeaturedFiles(sample);
const activeFile = await readFeaturedFile(sample, file);
const source = getSampleSource(sample);
---

<AppShell
  title={`${file.label} | ${sample.title}`}
  description={`Read ${file.path}, a curated source file from ${sample.project.name}.`}
  activeNav="samples"
>
  <section class="code-page-header">
    <div class="site-container stack">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href={sitePath("/")}>Home</a></li>
          <li><a href={sitePath("/samples/")}>Browse</a></li>
          <li>
            <a href={sitePath(sampleDetailPath(sample.id))}>
              {sample.project.name}
            </a>
          </li>
          <li aria-current="page">{file.label}</li>
        </ol>
      </nav>
      <div class="code-page-layout">
        <div class="stack code-page-heading">
          <a class="source-label" href={source.canonicalUrl}>{source.label}</a>
          <p class="eyebrow">Code</p>
          <h1>{file.label}</h1>
          <p><code>{file.path}</code></p>
        </div>
        <a
          class="back-link"
          href={sitePath(sampleDetailPath(sample.id))}
        >
          ← {sample.title}
        </a>
      </div>
    </div>
  </section>

  <section class="section code-page-content">
    <div class="site-container">
      <CodeBrowser
        activeFile={activeFile}
        currentRoute
        files={files}
        sample={sample}
      />
    </div>
  </section>
</AppShell>

<style>
  .code-page-header {
    padding-block: var(--site-space-5) clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--site-color-border-subtle);
    background:
      radial-gradient(circle at 85% 10%, var(--site-color-brand-subtle), transparent 28rem),
      var(--site-color-canvas-subtle);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--site-space-2);
    padding: 0;
    color: var(--site-color-text-muted);
    font-size: 0.78rem;
    list-style: none;
  }

  .breadcrumb li:not(:last-child)::after {
    margin-left: var(--site-space-2);
    content: "/";
  }

  .code-page-layout {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--site-space-6);
    margin-top: var(--site-space-7);
  }

  .code-page-heading {
    --stack-space: var(--site-space-3);
    min-width: 0;
  }

  .code-page-heading h1 {
    font-size: clamp(2.4rem, 5vw, 4.5rem);
  }

  .code-page-heading > p:last-child {
    overflow-wrap: anywhere;
    color: var(--site-color-text-secondary);
  }

  .back-link {
    flex-shrink: 0;
    color: var(--site-color-text-secondary);
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
  }

  .code-page-content {
    padding-top: var(--site-space-7);
  }

  @media (max-width: 42rem) {
    .code-page-layout {
      align-items: start;
      flex-direction: column;
      margin-top: var(--site-space-6);
    }
  }
</style>
