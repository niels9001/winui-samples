---
import { ArrowRightRegular } from "@fluentui/react-icons/svg/arrow-right";

import AppShell from "../components/AppShell.astro";
import GetStarted from "../components/GetStarted.astro";
import SampleMedia from "../components/SampleMedia.astro";
import ShowcaseStage from "../components/ShowcaseStage.astro";
import { SampleIcon } from "../components/SampleIcon";
import { catalog } from "../lib/catalog-data";
import { categoryById } from "../lib/catalog";
import {
  outcomeBrowsePath,
  outcomeLinks,
  selectFeaturedSamples,
} from "../lib/landing";
import { resolveAllHeroMedia } from "../lib/sample-media";
import { productName } from "../lib/site-metadata";
import { getSampleSource } from "../lib/source-provenance";
import { sitePath } from "../lib/urls";

const categories = categoryById(catalog);
const featured = selectFeaturedSamples(catalog.samples, 4);
const stageSamples = selectFeaturedSamples(catalog.samples, 3);
const heroMedia = new Map(
  (await resolveAllHeroMedia(featured)).map((media) => [media.sampleId, media]),
);
---

<AppShell
  title={productName}
  description="Explore working WinUI and Windows App SDK code by outcome, API, requirement, and implementation."
  activeNav="home"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="site-container hero-layout">
      <div class="hero-copy">
        <h1 id="hero-title">
          Find working Windows code for what you want to build.
        </h1>
        <p class="hero-summary">
          Start with an outcome, then move directly into the APIs,
          requirements, and implementation that make it work.
        </p>
        <div class="cluster hero-actions">
          <a class="button-link" href={sitePath("/samples/")}>
            Find an example <ArrowRightRegular aria-hidden="true" />
          </a>
          <a class="hero-text-link" href="#build-paths">
            Browse by capability
          </a>
        </div>
        <p class="hero-proof">
          <strong>{catalog.samples.length} focused examples</strong>
          <span>across {catalog.providers?.length ?? 3} trusted sources.</span>
        </p>
      </div>
      <ShowcaseStage samples={stageSamples} categories={categories} />
    </div>
  </section>

  <section
    class="section paths-section"
    id="build-paths"
    aria-labelledby="paths-title"
    data-scroll-reveal
  >
    <div class="site-container">
      <div class="section-header">
        <p class="eyebrow">Build by outcome</p>
        <h2 id="paths-title">Choose the part of your app you are working on</h2>
      </div>
      <div class="path-grid">
        {
          outcomeLinks.map((outcome) => {
            const category =
              outcome.facet === "primaryCategory"
                ? categories.get(outcome.value)
                : undefined;
            return (
              <a
                class="path-card surface"
                data-pointer-surface
                data-tilt
                href={sitePath(outcomeBrowsePath(outcome))}
              >
                <span class="path-icon">
                  <SampleIcon name={category?.icon ?? "AppsRegular"} />
                </span>
                <span>
                  <strong>{outcome.title}</strong>
                  <small>{outcome.description}</small>
                </span>
                <ArrowRightRegular aria-hidden="true" />
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section
    class="section featured-section"
    aria-labelledby="featured-title"
    data-scroll-reveal
  >
    <div class="site-container">
      <div class="featured-heading">
        <div class="section-header">
          <p class="eyebrow">Featured implementations</p>
          <h2 id="featured-title">Start from a complete, focused project</h2>
          <p class="secondary-text">
            These picks cover UI, storage, devices, and media with curated code
            paths and explicit requirements.
          </p>
        </div>
        <a href={sitePath("/samples/")}>
          See every example <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="featured-grid">
        {
          featured.map((sample, index) => {
            const category = categories.get(sample.categories.primary);
            const source = getSampleSource(sample);
            return (
              <article
                class:list={["featured-card", `featured-card--${index + 1}`]}
                data-pointer-surface
                data-tilt
              >
                <a
                  class="featured-visual-link"
                  href={sitePath(`/samples/${sample.id}/`)}
                  tabindex="-1"
                >
                  <SampleMedia
                    sample={sample}
                    category={category}
                    hero={heroMedia.get(sample.id)}
                  />
                </a>
                <div class="featured-copy">
                  <div class="featured-meta">
                    <span>{category?.label ?? sample.categories.primary}</span>
                    <a href={source.canonicalUrl}>{source.label}</a>
                  </div>
                  <h3>
                    <a href={sitePath(`/samples/${sample.id}/`)}>{sample.title}</a>
                  </h3>
                  {sample.summary && <p>{sample.summary}</p>}
                  <div class="featured-facts">
                    <span>{sample.languages?.join(" / ")}</span>
                    <span>{sample.project.name}</span>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <GetStarted />
</AppShell>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(3.75rem, 7vw, 6rem) clamp(3.5rem, 6vw, 5.5rem);
  }

  .hero::before {
    position: absolute;
    width: 38rem;
    height: 38rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--site-color-brand) 12%, transparent);
    content: "";
    filter: blur(6rem);
    inset: -20rem auto auto -16rem;
    pointer-events: none;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(24rem, 0.9fr) minmax(31rem, 1.1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-copy {
    display: grid;
    max-width: 46rem;
    gap: var(--site-space-5);
  }

  .hero h1 {
    max-width: 13ch;
    font-size: clamp(2.5rem, 4.8vw, 4.65rem);
    letter-spacing: -0.04em;
  }

  .hero-summary {
    max-width: 38rem;
    color: var(--site-color-text-secondary);
    font-size: clamp(1.08rem, 1.8vw, 1.3rem);
  }

  .hero-actions {
    --cluster-space: var(--site-space-5);
  }

  .hero-text-link {
    color: var(--site-color-text);
    font-weight: 660;
    text-decoration-color: var(--site-color-border);
  }

  .hero-proof {
    max-width: 34rem;
    padding-top: var(--site-space-3);
    border-top: 1px solid var(--site-color-border-subtle);
    color: var(--site-color-text-muted);
    font-size: 0.86rem;
  }

  .hero-proof strong {
    color: var(--site-color-text);
  }

  .hero-proof span {
    margin-left: 0.35em;
  }

  .paths-section {
    border-block: 1px solid var(--site-color-border-subtle);
    background: color-mix(
      in srgb,
      var(--site-color-canvas-subtle) 76%,
      transparent
    );
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--site-space-3);
  }

  .path-card {
    display: grid;
    min-width: 0;
    min-height: 12rem;
    grid-template: auto 1fr / 1fr auto;
    align-content: space-between;
    gap: var(--site-space-4);
    padding: var(--site-space-5);
    color: var(--site-color-text);
    text-decoration: none;
  }

  .path-card:hover {
    border-color: var(--site-color-brand);
    box-shadow: var(--site-shadow-flyout);
    color: var(--site-color-text);
    transform:
      perspective(70rem)
      rotateX(var(--tilt-x, 0deg))
      rotateY(var(--tilt-y, 0deg))
      translateY(-3px);
  }

  .path-icon {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border-radius: var(--site-radius-medium);
    background: var(--site-color-brand-subtle);
    color: var(--site-color-brand);
    font-size: 1.35rem;
  }

  .path-card > span:nth-child(2) {
    display: grid;
    grid-column: 1 / -1;
    align-self: end;
    gap: var(--site-space-2);
  }

  .path-card small {
    color: var(--site-color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .path-card > :global(svg) {
    width: 1rem;
    color: var(--site-color-text-muted);
  }

  .featured-section {
    overflow: clip;
  }

  .featured-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--site-space-6);
  }

  .featured-heading > a {
    margin-bottom: var(--site-space-7);
    font-weight: 680;
    text-decoration: none;
    white-space: nowrap;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--site-space-5);
  }

  .featured-card {
    position: relative;
    display: grid;
    overflow: hidden;
    grid-template-columns: minmax(14rem, 0.9fr) minmax(0, 1.1fr);
    border: 1px solid var(--site-color-border-subtle);
    border-radius: var(--site-radius-xlarge);
    background: var(--site-color-surface);
    box-shadow: var(--site-shadow-card);
    backdrop-filter: blur(24px);
  }

  .featured-card:hover {
    border-color: var(--site-color-brand);
    box-shadow: var(--site-shadow-flyout);
  }

  .featured-visual-link {
    display: block;
    min-width: 0;
  }

  .featured-card :global(.detail-visual),
  .featured-card :global(.detail-visual img),
  .featured-card :global(.detail-visual-fallback) {
    height: 100%;
    aspect-ratio: auto;
  }

  .featured-card :global(.detail-visual) {
    border: 0;
    border-right: 1px solid var(--site-color-border-subtle);
    border-radius: 0;
    box-shadow: none;
  }

  .featured-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--site-space-3);
    padding: var(--site-space-5);
  }

  .featured-meta,
  .featured-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--site-space-2) var(--site-space-4);
    color: var(--site-color-text-muted);
    font-size: 0.74rem;
  }

  .featured-meta a {
    position: relative;
    color: var(--site-color-text-muted);
  }

  .featured-copy h3 {
    font-size: 1.35rem;
  }

  .featured-copy h3 a {
    color: var(--site-color-text);
    text-decoration: none;
  }

  .featured-copy h3 a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .featured-copy h3,
  .featured-copy > p,
  .featured-meta,
  .featured-facts {
    position: relative;
  }

  .featured-copy > p {
    display: -webkit-box;
    overflow: hidden;
    color: var(--site-color-text-secondary);
    font-size: 0.9rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .featured-facts {
    margin-top: auto;
    padding-top: var(--site-space-3);
    border-top: 1px solid var(--site-color-border-subtle);
  }

  @media (max-width: 72rem) {
    .hero-layout {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      max-width: 58rem;
    }

    .hero h1 {
      max-width: 14ch;
    }

    .path-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .featured-card {
      grid-template-columns: 1fr;
    }

    .featured-card :global(.detail-visual),
    .featured-card :global(.detail-visual img),
    .featured-card :global(.detail-visual-fallback) {
      height: auto;
      aspect-ratio: 16 / 10;
    }

    .featured-card :global(.detail-visual) {
      border-right: 0;
      border-bottom: 1px solid var(--site-color-border-subtle);
    }
  }

  @media (max-width: 48rem) {
    .path-grid,
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .path-card {
      min-height: 0;
      grid-template: auto / auto minmax(0, 1fr) auto;
      align-items: center;
    }

    .path-card > span:nth-child(2) {
      grid-column: auto;
      align-self: center;
    }

    .featured-heading {
      align-items: start;
      flex-direction: column;
      margin-bottom: var(--site-space-6);
    }

    .featured-heading .section-header,
    .featured-heading > a {
      margin-bottom: 0;
    }
  }

  @media (max-width: 36rem) {
    .hero {
      padding-block: 3rem 3.5rem;
    }

    .hero h1 {
      max-width: 13ch;
      font-size: clamp(2.4rem, 11vw, 3.2rem);
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero-actions .button-link {
      width: 100%;
    }
  }

  @media (forced-colors: active) {
    .hero::before {
      display: none;
    }

    .featured-card,
    .paths-section {
      border-color: CanvasText;
      background: Canvas;
    }
  }
</style>
