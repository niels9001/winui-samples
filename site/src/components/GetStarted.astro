---
import { BookOpenRegular } from "@fluentui/react-icons/svg/book-open";
import { CodeRegular } from "@fluentui/react-icons/svg/code";
import { ToolboxRegular } from "@fluentui/react-icons/svg/toolbox";

import CodeBlock from "./CodeBlock.astro";
import { getStartedResources } from "../data/get-started";

const resourceIcons = {
  "windows-app-sdk": ToolboxRegular,
  "windows-app-development": BookOpenRegular,
  "winui-skills": CodeRegular,
} as const;
const quickStart = `git clone https://github.com/niels9001/winui-samples.git
cd winui-samples\\Samples\\FileAccess
dotnet build -c Debug -p:Platform=x64`;
---

<section
  class="section get-started-section"
  id="get-started"
  aria-labelledby="get-started-title"
  data-scroll-reveal
>
  <div class="site-container get-started-layout">
    <div class="stack get-started-copy">
      <p class="eyebrow">Start building</p>
      <h2 id="get-started-title">Run a project, then make it yours</h2>
      <p class="secondary-text">
        Use a Windows machine with the current .NET SDK, Visual Studio build
        tools, and the Windows App SDK workload.
      </p>
      <CodeBlock
        code={quickStart}
        label="Build FileAccess with PowerShell"
        copyLabel="Copy FileAccess setup commands"
      />
    </div>
    <div class="resource-list">
      {
        getStartedResources.map((resource) => {
          const Icon = resourceIcons[resource.id];
          return (
            <a
              class="resource-link surface"
              data-pointer-surface
              href={resource.href}
            >
              <span class="resource-icon">
                <Icon aria-hidden="true" />
              </span>
              <span>
                <strong>{resource.title}</strong>
                <small>{resource.description}</small>
                <span>{resource.linkLabel} <span aria-hidden="true">↗</span></span>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .get-started-section {
    border-block: 1px solid var(--site-color-border-subtle);
    background:
      radial-gradient(circle at 12% 20%, var(--site-color-brand-subtle), transparent 30rem),
      var(--site-color-canvas-subtle);
  }

  .get-started-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(22rem, 1.08fr);
    align-items: start;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .get-started-copy {
    --stack-space: var(--site-space-4);
    min-width: 0;
  }

  .get-started-copy > p:last-of-type {
    max-width: 38rem;
  }

  .get-started-copy :global(.code-block) {
    margin-top: var(--site-space-3);
  }

  .resource-list {
    display: grid;
    min-width: 0;
    gap: var(--site-space-3);
  }

  .resource-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--site-space-4);
    padding: var(--site-space-5);
    color: var(--site-color-text);
    text-decoration: none;
  }

  .resource-link:hover {
    border-color: var(--site-color-brand);
    box-shadow: var(--site-shadow-flyout);
    color: var(--site-color-text);
    transform: translateY(-2px);
  }

  .resource-icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: var(--site-radius-medium);
    background: var(--site-color-brand-subtle);
    color: var(--site-color-brand);
    font-size: 1.25rem;
  }

  .resource-link > span:last-child {
    display: grid;
    gap: var(--site-space-1);
  }

  .resource-link small {
    color: var(--site-color-text-secondary);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .resource-link > span:last-child > span {
    margin-top: var(--site-space-2);
    color: var(--site-color-brand);
    font-size: 0.82rem;
    font-weight: 680;
  }

  @media (max-width: 58rem) {
    .get-started-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--site-space-7);
    }
  }

  @media (forced-colors: active) {
    .get-started-section {
      background: Canvas;
    }
  }
</style>
