---
import { SampleIcon } from "./SampleIcon";
import type {
  CatalogCategory,
  CatalogSample,
} from "../lib/catalog";
import type { HeroMedia } from "../lib/sample-media";
import { sitePath } from "../lib/urls";
import { fallbackVisualIndex } from "../lib/visuals";

interface Props {
  sample: CatalogSample;
  category?: CatalogCategory;
  hero?: HeroMedia;
  eager?: boolean;
}

const { sample, category, hero, eager = false } = Astro.props;
const categoryLabel = category?.label ?? sample.categories.primary;
---

<div class="detail-visual">
  {
    hero ? (
      <img
        alt={sample.screenshots[0]?.alt ?? ""}
        decoding="async"
        fetchpriority={eager ? "high" : "auto"}
        height="720"
        loading={eager ? "eager" : "lazy"}
        src={sitePath(hero.routePath)}
        width="1280"
      />
    ) : (
      <div
        class={`detail-visual-fallback visual-theme-${fallbackVisualIndex(
          sample.categories.primary,
        )}`}
        role="img"
        aria-label={`${categoryLabel} example preview`}
      >
        <span class="detail-visual-grid" aria-hidden="true"></span>
        <span class="preview-window" aria-hidden="true">
          <span class="preview-titlebar"></span>
          <span class="preview-navigation"></span>
          <span class="preview-content">
            <i></i><i></i><i></i><i></i>
          </span>
        </span>
        <span class="preview-flyout" aria-hidden="true">
          <SampleIcon name={category?.icon ?? sample.icon} />
        </span>
        <span class="preview-label">{sample.project.name}</span>
      </div>
    )
  }
</div>

<style>
  .detail-visual {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, white 28%, transparent);
    border-radius: calc(var(--site-radius-large) + 4px);
    box-shadow: var(--site-shadow-window);
  }

  .detail-visual,
  .detail-visual img,
  .detail-visual-fallback {
    width: 100%;
    aspect-ratio: 16 / 10;
  }

  .detail-visual img {
    object-fit: cover;
  }

  .detail-visual-fallback {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 12%, rgb(255 255 255 / 36%), transparent 26%),
      linear-gradient(135deg, var(--visual-start), var(--visual-end));
    color: #ffffff;
    isolation: isolate;
  }

  .detail-visual-grid {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 9%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 9%) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    mask-image: linear-gradient(to bottom right, #000, transparent 86%);
  }

  .preview-window {
    position: absolute;
    width: 70%;
    height: 68%;
    top: 12%;
    left: 15%;
    display: grid;
    overflow: hidden;
    grid-template: 1.6rem 1fr / 24% 1fr;
    border: 1px solid rgb(255 255 255 / 42%);
    border-radius: 0.7rem;
    background: rgb(240 248 255 / 16%);
    box-shadow: 0 1.5rem 3.4rem rgb(0 0 0 / 24%);
    transform: perspective(40rem) rotateY(-7deg) rotateX(2deg);
    backdrop-filter: blur(20px) saturate(130%);
  }

  .preview-titlebar {
    grid-column: 1 / -1;
    border-bottom: 1px solid rgb(255 255 255 / 24%);
    background:
      radial-gradient(circle at calc(100% - 1rem) 50%, #fff 0 2px, transparent 3px),
      rgb(255 255 255 / 6%);
  }

  .preview-navigation {
    border-right: 1px solid rgb(255 255 255 / 22%);
    background:
      linear-gradient(rgb(255 255 255 / 52%) 0 0) 50% 1.15rem / 58% 0.22rem no-repeat,
      repeating-linear-gradient(
        180deg,
        rgb(255 255 255 / 25%) 0 2px,
        transparent 2px 1.35rem
      );
    background-position: 50% 1.1rem, 50% 2.6rem;
    background-size: 58% 0.22rem, 58% auto;
  }

  .preview-content {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--site-space-3);
    padding: 12%;
  }

  .preview-content i {
    min-height: 2.5rem;
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 0.45rem;
    background:
      linear-gradient(rgb(255 255 255 / 22%) 0 0) 0.65rem calc(100% - 0.65rem) /
        58% 0.25rem no-repeat,
      rgb(255 255 255 / 10%);
  }

  .preview-content i:first-child {
    grid-column: 1 / -1;
  }

  .preview-flyout {
    position: absolute;
    right: 8%;
    bottom: 10%;
    display: grid;
    width: clamp(3.4rem, 10vw, 5rem);
    height: clamp(3.4rem, 10vw, 5rem);
    place-items: center;
    border: 1px solid rgb(255 255 255 / 42%);
    border-radius: var(--site-radius-large);
    background: rgb(5 17 30 / 34%);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 28%);
    backdrop-filter: blur(20px);
  }

  .preview-flyout :global(svg) {
    width: 48%;
    height: 48%;
  }

  .preview-label {
    position: absolute;
    right: var(--site-space-5);
    bottom: var(--site-space-4);
    left: var(--site-space-5);
    font-size: 0.78rem;
    font-weight: 680;
    text-shadow: 0 1px 3px rgb(0 0 0 / 45%);
  }

  .visual-theme-0 {
    --visual-start: #0868b9;
    --visual-end: #7454db;
  }

  .visual-theme-1 {
    --visual-start: #006f69;
    --visual-end: #0078d4;
  }

  .visual-theme-2 {
    --visual-start: #6941a5;
    --visual-end: #b52aa8;
  }

  .visual-theme-3 {
    --visual-start: #0067c0;
    --visual-end: #008f9c;
  }

  .visual-theme-4 {
    --visual-start: #425fd6;
    --visual-end: #7f2a9e;
  }

  .visual-theme-5 {
    --visual-start: #147616;
    --visual-end: #0067c0;
  }

  @media (forced-colors: active) {
    .detail-visual,
    .detail-visual-fallback,
    .preview-window,
    .preview-flyout {
      border: 1px solid CanvasText;
      background: Canvas;
      color: CanvasText;
      box-shadow: none;
      backdrop-filter: none;
    }
  }
</style>
