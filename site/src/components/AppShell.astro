---
import { ThemeSwitcher } from "./ThemeSwitcher";
import { sitePath } from "../lib/urls";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  activeNav?: "home" | "samples";
}

const { title, description, activeNav } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const navigation = [
  {
    label: "Home",
    href: sitePath("/"),
    active: activeNav === "home",
  },
  {
    label: "Browse samples",
    href: sitePath("/samples/"),
    active: activeNav === "samples",
  },
  {
    label: "Get started",
    href: sitePath("/#get-started"),
    active: false,
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f6cbd" />
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const storageKey = "winui-samples-theme";
        const stored = window.localStorage.getItem(storageKey);
        const preference =
          stored === "light" || stored === "dark" || stored === "system"
            ? stored
            : "system";
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
          .matches
          ? "dark"
          : "light";
        document.documentElement.dataset.theme =
          preference === "system" ? systemTheme : preference;
        document.documentElement.dataset.themePreference = preference;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="site-container header-content">
        <a class="brand" href={sitePath("/")} aria-label="Windows app samples home">
          <span class="brand-mark" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </span>
          <span>Windows app samples</span>
        </a>
        <nav class="primary-navigation" aria-label="Primary navigation">
          {
            navigation.map((item) => (
              <a
                aria-current={item.active ? "page" : undefined}
                class:list={["navigation-link", { active: item.active }]}
                href={item.href}
              >
                {item.label}
              </a>
            ))
          }
          <a
            class="navigation-link"
            href="https://github.com/niels9001/winui-samples"
          >
            GitHub
          </a>
        </nav>
        <div class="theme-control">
          <ThemeSwitcher client:only="react" />
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-container footer-content">
        <p>Practical WinUI 3 samples, migrated for the Windows App SDK.</p>
        <a href="https://github.com/niels9001/winui-samples">
          View the repository
        </a>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--site-color-border-subtle);
    background: color-mix(in srgb, var(--site-color-canvas) 86%, transparent);
    backdrop-filter: blur(20px) saturate(125%);
  }

  .header-content {
    display: grid;
    min-height: 4rem;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--site-space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--site-space-3);
    color: var(--site-color-text);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--site-color-text);
  }

  .brand-mark {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
  }

  .brand-mark span {
    background: var(--site-color-brand);
  }

  .primary-navigation {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
    gap: var(--site-space-1);
  }

  .navigation-link {
    padding: 0.4rem 0.65rem;
    border-radius: var(--site-radius-small);
    color: var(--site-color-text-secondary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .navigation-link:hover,
  .navigation-link.active {
    background: var(--site-color-surface-hover);
    color: var(--site-color-text);
  }

  .navigation-link.active {
    box-shadow: inset 0 -2px var(--site-color-brand);
  }

  .theme-control {
    justify-self: end;
  }

  .site-footer {
    margin-top: var(--site-space-8);
    border-top: 1px solid var(--site-color-border-subtle);
    background: var(--site-color-canvas-subtle);
  }

  .footer-content {
    display: flex;
    min-height: 6rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--site-space-4);
    color: var(--site-color-text-secondary);
    font-size: 0.9rem;
  }

  @media (max-width: 55rem) {
    .header-content {
      grid-template-columns: 1fr auto;
      gap: var(--site-space-2) var(--site-space-4);
      padding-block: var(--site-space-2);
    }

    .primary-navigation {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: var(--site-space-1);
    }

    .theme-control {
      grid-column: 2;
    }
  }
</style>
