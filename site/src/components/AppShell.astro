---
import ThemeSwitcher from "./ThemeSwitcher.astro";
import { repositoryWebUrl, sitePath } from "../lib/urls";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  activeNav?: "home" | "samples";
}

const { title, description, activeNav } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const navigation = [
  {
    label: "Home",
    href: sitePath("/"),
    active: activeNav === "home",
  },
  {
    label: "Browse",
    href: sitePath("/samples/"),
    active: activeNav === "samples",
  },
  {
    label: "Start",
    href: sitePath("/#get-started"),
    active: false,
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0067c0" />
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = window.localStorage.getItem("winui-samples-theme");
        const preference =
          stored === "light" || stored === "dark" || stored === "system"
            ? stored
            : "system";
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
          .matches
          ? "dark"
          : "light";
        document.documentElement.dataset.theme =
          preference === "system" ? systemTheme : preference;
        document.documentElement.dataset.themePreference = preference;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-container header-content">
        <a class="brand" href={sitePath("/")} aria-label="Windows app code home">
          <span class="brand-mark" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </span>
          <span>Windows app code</span>
        </a>
        <nav class="primary-navigation" aria-label="Primary navigation">
          {
            navigation.map((item) => (
              <a
                aria-current={item.active ? "page" : undefined}
                class:list={["navigation-link", { active: item.active }]}
                href={item.href}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="theme-control">
          <ThemeSwitcher />
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-container footer-content">
        <div>
          <strong>Windows app code</strong>
          <p>Working examples for WinUI and the Windows App SDK.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href={sitePath("/samples/")}>Browse</a>
          <a href="https://learn.microsoft.com/windows/apps/">Windows docs</a>
          <a href={repositoryWebUrl}>Source</a>
        </nav>
      </div>
    </footer>
    <div
      class="visually-hidden"
      aria-live="polite"
      aria-atomic="true"
      data-global-status
    ></div>
    <script>
      const resetTimers = new WeakMap<HTMLButtonElement, number>();
      const globalStatus =
        document.querySelector<HTMLElement>("[data-global-status]");

      async function writeClipboard(text: string): Promise<void> {
        if (!navigator.clipboard?.writeText) {
          throw new Error("Clipboard access is unavailable.");
        }
        await navigator.clipboard.writeText(text);
      }

      document.addEventListener("click", async (event) => {
        const target =
          event.target instanceof Element
            ? event.target.closest<HTMLButtonElement>("[data-copy-control]")
            : null;
        if (!target) return;

        const sourceSelector = target.dataset.copyTarget;
        const source = sourceSelector
          ? document.querySelector(sourceSelector)
          : null;
        const text = target.dataset.copyText ?? source?.textContent;
        const idleLabel = target.dataset.copyIdleLabel ?? "Copy";
        const successLabel = target.dataset.copySuccessLabel ?? "Copied";
        if (text === undefined || text === null) {
          target.dataset.copyState = "error";
          target.setAttribute("aria-label", "Copy unavailable");
          if (globalStatus) globalStatus.textContent = "Copy unavailable.";
          return;
        }

        try {
          await writeClipboard(text);
          target.dataset.copyState = "success";
          target.setAttribute("aria-label", successLabel);
          if (globalStatus) globalStatus.textContent = `${successLabel}.`;
        } catch {
          target.dataset.copyState = "error";
          target.setAttribute("aria-label", "Copy failed");
          if (globalStatus) globalStatus.textContent = "Copy failed.";
        }

        const previousTimer = resetTimers.get(target);
        if (previousTimer !== undefined) window.clearTimeout(previousTimer);
        resetTimers.set(
          target,
          window.setTimeout(() => {
            target.setAttribute("aria-label", idleLabel);
            delete target.dataset.copyState;
          }, 2200),
        );
      });

      const finePointer = window.matchMedia(
        "(pointer: fine) and (prefers-reduced-motion: no-preference)",
      );
      if (finePointer.matches) {
        document.addEventListener(
          "pointermove",
          (event) => {
            document.documentElement.style.setProperty(
              "--page-pointer-x",
              `${event.clientX}px`,
            );
            document.documentElement.style.setProperty(
              "--page-pointer-y",
              `${event.clientY}px`,
            );
          },
          { passive: true },
        );

        for (const element of document.querySelectorAll<HTMLElement>(
          "[data-pointer-surface]",
        )) {
          element.addEventListener(
            "pointermove",
            (event) => {
              const rect = element.getBoundingClientRect();
              const x = event.clientX - rect.left;
              const y = event.clientY - rect.top;
              element.style.setProperty("--pointer-x", `${x}px`);
              element.style.setProperty("--pointer-y", `${y}px`);
              if (element.hasAttribute("data-tilt")) {
                element.style.setProperty(
                  "--tilt-x",
                  `${((0.5 - y / rect.height) * 2.4).toFixed(2)}deg`,
                );
                element.style.setProperty(
                  "--tilt-y",
                  `${((x / rect.width - 0.5) * 2.8).toFixed(2)}deg`,
                );
              }
            },
            { passive: true },
          );
          element.addEventListener("pointerleave", () => {
            element.style.removeProperty("--tilt-x");
            element.style.removeProperty("--tilt-y");
          });
        }
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    z-index: 30;
    top: 0;
    border-bottom: 1px solid var(--site-color-border-subtle);
    background: color-mix(in srgb, var(--site-color-canvas) 78%, transparent);
    backdrop-filter: blur(28px) saturate(145%);
  }

  .header-content {
    display: grid;
    min-height: 4.25rem;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--site-space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--site-space-3);
    color: var(--site-color-text);
    font-weight: 690;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--site-color-text);
  }

  .brand-mark {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    transform: perspective(4rem) rotateY(-7deg);
  }

  .brand-mark span {
    background: var(--site-color-brand);
  }

  .primary-navigation {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
    gap: var(--site-space-1);
  }

  .navigation-link {
    position: relative;
    padding: 0.48rem 0.72rem;
    border-radius: var(--site-radius-small);
    color: var(--site-color-text-secondary);
    font-size: 0.9rem;
    font-weight: 620;
    text-decoration: none;
  }

  .navigation-link:hover,
  .navigation-link.active {
    background: var(--site-color-surface-hover);
    color: var(--site-color-text);
  }

  .navigation-link.active::after {
    position: absolute;
    right: 0.72rem;
    bottom: 0.2rem;
    left: 0.72rem;
    height: 2px;
    border-radius: 999px;
    background: var(--site-color-brand);
    content: "";
  }

  .theme-control {
    justify-self: end;
  }

  .site-footer {
    margin-top: var(--site-space-9);
    border-top: 1px solid var(--site-color-border-subtle);
    background: color-mix(
      in srgb,
      var(--site-color-canvas-subtle) 88%,
      transparent
    );
  }

  .footer-content {
    display: flex;
    min-height: 8rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--site-space-5);
    color: var(--site-color-text-secondary);
    font-size: 0.88rem;
  }

  .footer-content strong {
    color: var(--site-color-text);
  }

  .footer-content nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--site-space-5);
  }

  .footer-content a {
    color: var(--site-color-text-secondary);
    text-decoration: none;
  }

  .footer-content a:hover {
    color: var(--site-color-text);
  }

  @media (max-width: 42rem) {
    .header-content {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 var(--site-space-2);
      padding-top: var(--site-space-2);
    }

    .brand {
      overflow: hidden;
      font-size: 0.94rem;
      text-overflow: ellipsis;
    }

    .primary-navigation {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-content: flex-start;
      padding-block: var(--site-space-1) var(--site-space-2);
    }

    .theme-control {
      grid-column: 2;
    }

    .footer-content {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: var(--site-space-6);
    }
  }

  @media (forced-colors: active) {
    .site-header {
      background: Canvas;
      backdrop-filter: none;
    }

    .navigation-link.active {
      outline: 2px solid Highlight;
    }
  }
</style>
