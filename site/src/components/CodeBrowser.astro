---
import { CopyRegular } from "@fluentui/react-icons/svg/copy";
import { OpenRegular } from "@fluentui/react-icons/svg/open";
import { codeToHtml } from "shiki";

import type { CatalogSample } from "../lib/catalog";
import type {
  FeaturedFileDescriptor,
  FeaturedFileReadResult,
} from "../lib/featured-files";
import { sitePath } from "../lib/urls";

interface Props {
  sample: CatalogSample;
  files: FeaturedFileDescriptor[];
  activeFile: FeaturedFileReadResult;
  currentRoute?: boolean;
}

const {
  sample,
  files,
  activeFile,
  currentRoute = false,
} = Astro.props;
const descriptor = activeFile.descriptor;
const sourceId = `source-${sample.id}-${descriptor.key}`;
const highlighted =
  activeFile.status === "ready"
    ? await codeToHtml(activeFile.code, {
        lang: activeFile.descriptor.language,
        themes: {
          light: "github-light",
          dark: "github-dark",
        },
        defaultColor: false,
      })
    : undefined;
---

<section
  class="code-browser surface"
  aria-labelledby={`code-title-${descriptor.key}`}
>
  <div class="code-browser-header">
    <div class="stack code-browser-heading">
      <p class="code-path">{descriptor.path}</p>
      <h2 id={`code-title-${descriptor.key}`}>{descriptor.label}</h2>
      {
        descriptor.description && (
          <p class="secondary-text">{descriptor.description}</p>
        )
      }
    </div>
    <div class="code-browser-actions" aria-label="Code actions">
      <span class="language-label">{descriptor.languageLabel}</span>
      <button
        class="icon-button"
        data-copy-control
        data-copy-idle-label="Copy file path"
        data-copy-success-label="File path copied"
        data-copy-text={descriptor.path}
        type="button"
        aria-label="Copy file path"
      >
        <CopyRegular aria-hidden="true" />
      </button>
      {
        activeFile.status === "ready" && (
          <button
            class="icon-button"
            data-copy-control
            data-copy-idle-label="Copy source code"
            data-copy-success-label="Source code copied"
            data-copy-target={`#${sourceId}`}
            type="button"
            aria-label="Copy source code"
          >
            <CopyRegular aria-hidden="true" />
          </button>
        )
      }
      <a
        class="icon-button"
        href={descriptor.sourceUrl}
        aria-label="Open file in source"
      >
        <OpenRegular aria-hidden="true" />
      </a>
    </div>
  </div>

  <div class="code-browser-layout">
    <nav class="code-file-navigation" aria-label="Curated files">
      <div class="file-navigation-heading">
        <strong>Files</strong>
        <span>{files.length}</span>
      </div>
      <ul>
        {
          files.map((file) => (
            <li>
              {
                file.routePath ? (
                  <a
                    aria-current={
                      currentRoute && file.key === descriptor.key
                        ? "page"
                        : undefined
                    }
                    class:list={{ active: file.key === descriptor.key }}
                    href={sitePath(file.routePath)}
                  >
                    <span>{file.label}</span>
                    <code>{file.path}</code>
                  </a>
                ) : (
                  <a href={file.sourceUrl}>
                    <span>{file.label}</span>
                    <code>{file.path} · source only</code>
                  </a>
                )
              }
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="code-viewer" aria-label={`${descriptor.path} source code`}>
      {
        highlighted ? (
          <div id={sourceId} set:html={highlighted}></div>
        ) : (
          <div class="code-unavailable" role="status">
            <h3>Preview unavailable</h3>
            <p>{activeFile.status === "unavailable" && activeFile.reason}</p>
            <a href={descriptor.sourceUrl}>Open the source file</a>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .code-browser {
    overflow: hidden;
    box-shadow: none;
  }

  .code-browser-header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--site-space-5);
    padding: var(--site-space-5);
    border-bottom: 1px solid var(--site-color-border-subtle);
  }

  .code-browser-heading {
    --stack-space: var(--site-space-2);
    max-width: 42rem;
    min-width: 0;
  }

  .code-path {
    overflow: hidden;
    color: var(--site-color-text-muted);
    font-family: var(--site-font-mono);
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .code-browser-heading h2 {
    font-size: 1.4rem;
  }

  .code-browser-heading .secondary-text {
    font-size: 0.88rem;
  }

  .code-browser-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--site-space-2);
  }

  .language-label {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    padding-inline: 0.7rem;
    border-radius: var(--site-radius-small);
    background: var(--site-color-brand-subtle);
    color: var(--site-color-brand);
    font-size: 0.72rem;
    font-weight: 680;
  }

  .code-browser-layout {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(13rem, 17rem) minmax(0, 1fr);
  }

  .code-file-navigation {
    max-height: 42rem;
    overflow: auto;
    border-right: 1px solid var(--site-color-border-subtle);
    background: var(--site-color-canvas-subtle);
    scrollbar-gutter: stable;
  }

  .file-navigation-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--site-space-3) var(--site-space-4) var(--site-space-2);
    color: var(--site-color-text-secondary);
    font-size: 0.72rem;
  }

  .file-navigation-heading span {
    color: var(--site-color-text-muted);
  }

  .code-file-navigation ul {
    display: grid;
    gap: var(--site-space-1);
    padding: 0 var(--site-space-2) var(--site-space-2);
    list-style: none;
  }

  .code-file-navigation a {
    display: grid;
    gap: var(--site-space-1);
    padding: var(--site-space-3);
    border-radius: var(--site-radius-small);
    color: var(--site-color-text);
    text-decoration: none;
  }

  .code-file-navigation a:hover,
  .code-file-navigation a.active {
    background: var(--site-color-surface-hover);
  }

  .code-file-navigation a.active {
    box-shadow: inset 3px 0 var(--site-color-brand);
  }

  .code-file-navigation a > span {
    font-size: 0.82rem;
    font-weight: 680;
  }

  .code-file-navigation code {
    overflow: hidden;
    color: var(--site-color-text-muted);
    font-size: 0.67rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .code-viewer {
    min-width: 0;
    max-height: 42rem;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .code-viewer :global(.shiki) {
    min-width: max-content;
    min-height: 100%;
    padding-block: var(--site-space-4);
    border: 0;
    border-radius: 0;
    margin: 0;
    background: var(--shiki-light-bg);
    color: var(--shiki-light);
    counter-reset: source-line;
    font-size: 0.8rem;
    line-height: 1.65;
    tab-size: 4;
  }

  .code-viewer :global(.shiki code) {
    display: block;
  }

  .code-viewer :global(.shiki .line) {
    display: inline-block;
    min-width: 100%;
    padding-right: var(--site-space-5);
  }

  .code-viewer :global(.shiki .line)::before {
    display: inline-block;
    width: 3.5rem;
    padding-right: var(--site-space-3);
    color: var(--site-color-text-muted);
    content: counter(source-line);
    counter-increment: source-line;
    font-variant-numeric: tabular-nums;
    text-align: right;
    user-select: none;
  }

  .code-viewer :global(.shiki span) {
    color: var(--shiki-light);
  }

  :global(:root[data-theme="dark"]) .code-viewer :global(.shiki) {
    background: var(--shiki-dark-bg);
    color: var(--shiki-dark);
  }

  :global(:root[data-theme="dark"]) .code-viewer :global(.shiki span) {
    color: var(--shiki-dark);
  }

  .code-unavailable {
    display: grid;
    min-height: 20rem;
    align-content: center;
    justify-items: start;
    gap: var(--site-space-3);
    padding: var(--site-space-6);
  }

  .code-unavailable p {
    max-width: 36rem;
    color: var(--site-color-text-secondary);
  }

  @media (max-width: 52rem) {
    .code-browser-header {
      align-items: stretch;
      flex-direction: column;
    }

    .code-browser-actions {
      justify-content: flex-start;
    }

    .code-browser-layout {
      grid-template-columns: 1fr;
    }

    .code-file-navigation {
      max-height: none;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--site-color-border-subtle);
      scroll-snap-type: x proximity;
      scrollbar-gutter: auto;
    }

    .file-navigation-heading {
      position: sticky;
      left: 0;
      width: 100%;
    }

    .code-file-navigation ul {
      display: flex;
      width: max-content;
      max-width: none;
      padding-top: 0;
    }

    .code-file-navigation li {
      width: min(15rem, 74vw);
      scroll-snap-align: start;
    }

    .code-file-navigation a.active {
      box-shadow: inset 0 -3px var(--site-color-brand);
    }
  }

  @media (forced-colors: active) {
    .code-file-navigation,
    .code-viewer :global(.shiki) {
      background: Canvas;
      color: CanvasText;
    }
  }
</style>
