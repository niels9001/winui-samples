---
import { codeToHtml } from "shiki";

import type { CatalogSample } from "../lib/catalog";
import type {
  FeaturedFileDescriptor,
  FeaturedFileReadResult,
} from "../lib/featured-files";
import { sitePath } from "../lib/urls";

interface Props {
  sample: CatalogSample;
  files: FeaturedFileDescriptor[];
  activeFile: FeaturedFileReadResult;
  currentRoute?: boolean;
}

const {
  sample,
  files,
  activeFile,
  currentRoute = false,
} = Astro.props;
const descriptor = activeFile.descriptor;
const sourceId = `source-${sample.id}-${descriptor.key}`;
const highlighted =
  activeFile.status === "ready"
    ? await codeToHtml(activeFile.code, {
        lang: activeFile.descriptor.language,
        themes: {
          light: "github-light",
          dark: "github-dark",
        },
        defaultColor: false,
      })
    : undefined;
---

<section class="code-browser surface" aria-labelledby={`code-title-${descriptor.key}`}>
  <div class="code-browser-header">
    <div class="stack code-browser-heading">
      <p class="eyebrow">Curated source</p>
      <h2 id={`code-title-${descriptor.key}`}>{descriptor.label}</h2>
      {
        descriptor.description && (
          <p class="secondary-text">{descriptor.description}</p>
        )
      }
    </div>
    <div class="cluster code-browser-actions">
      <span class="language-label">{descriptor.languageLabel}</span>
      <button
        class="code-action"
        data-copy-control
        data-copy-idle-label="Copy path"
        data-copy-text={descriptor.path}
        type="button"
      >
        <span data-copy-feedback aria-live="polite">Copy path</span>
      </button>
      {
        activeFile.status === "ready" && (
          <button
            class="code-action"
            data-copy-control
            data-copy-idle-label="Copy code"
            data-copy-target={`#${sourceId}`}
            type="button"
          >
            <span data-copy-feedback aria-live="polite">Copy code</span>
          </button>
        )
      }
      <a class="code-action" href={descriptor.githubUrl}>
        View on GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <div class="code-browser-layout">
    <nav class="code-file-navigation" aria-label="Featured files">
      <ul>
        {
          files.map((file) => (
            <li>
              <a
                aria-current={
                  currentRoute && file.key === descriptor.key
                    ? "page"
                    : undefined
                }
                class:list={{ active: file.key === descriptor.key }}
                href={sitePath(file.routePath)}
              >
                <span>{file.label}</span>
                <code>{file.path}</code>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="code-viewer" aria-label={`${descriptor.path} source code`}>
      {
        highlighted ? (
          <div id={sourceId} set:html={highlighted}></div>
        ) : (
          <div class="code-unavailable" role="status">
            <h3>Preview unavailable</h3>
            <p>{activeFile.status === "unavailable" && activeFile.reason}</p>
            <a href={descriptor.githubUrl}>Open this file on GitHub</a>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .code-browser {
    --stack-space: var(--site-space-3);
    overflow: hidden;
    box-shadow: none;
  }

  .code-browser-header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--site-space-5);
    padding: var(--site-space-5);
    border-bottom: 1px solid var(--site-color-border-subtle);
  }

  .code-browser-heading {
    max-width: 42rem;
  }

  .code-browser-heading h2 {
    font-size: 1.45rem;
  }

  .code-browser-actions {
    --cluster-space: var(--site-space-2);
    justify-content: flex-end;
  }

  .language-label,
  .code-action {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--site-color-border-subtle);
    border-radius: var(--site-radius-small);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .language-label {
    background: var(--site-color-brand-subtle);
    color: var(--site-color-brand);
  }

  .code-action {
    background: var(--site-color-surface-solid);
    color: var(--site-color-text);
    cursor: pointer;
    font-family: inherit;
    text-decoration: none;
  }

  .code-action:hover {
    border-color: var(--site-color-brand);
    background: var(--site-color-surface-hover);
    color: var(--site-color-text);
  }

  .code-action[data-copy-state="success"] {
    border-color: #107c10;
    color: #107c10;
  }

  .code-action[data-copy-state="error"] {
    border-color: #c50f1f;
    color: #c50f1f;
  }

  .code-browser-layout {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(13rem, 18rem) minmax(0, 1fr);
  }

  .code-file-navigation {
    max-height: 42rem;
    overflow: auto;
    border-right: 1px solid var(--site-color-border-subtle);
    background: var(--site-color-canvas-subtle);
  }

  .code-file-navigation ul {
    display: grid;
    padding: var(--site-space-2);
    list-style: none;
  }

  .code-file-navigation a {
    display: grid;
    gap: var(--site-space-1);
    padding: var(--site-space-3);
    border-radius: var(--site-radius-small);
    color: var(--site-color-text);
    text-decoration: none;
  }

  .code-file-navigation a:hover,
  .code-file-navigation a.active {
    background: var(--site-color-surface-hover);
  }

  .code-file-navigation a.active {
    box-shadow: inset 3px 0 var(--site-color-brand);
  }

  .code-file-navigation span {
    font-size: 0.86rem;
    font-weight: 650;
  }

  .code-file-navigation code {
    overflow: hidden;
    color: var(--site-color-text-muted);
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .code-viewer {
    min-width: 0;
    max-height: 42rem;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .code-viewer :global(.shiki) {
    min-width: max-content;
    min-height: 100%;
    padding-block: var(--site-space-4);
    border: 0;
    border-radius: 0;
    margin: 0;
    background: var(--shiki-light-bg);
    color: var(--shiki-light);
    counter-reset: source-line;
    font-size: 0.82rem;
    line-height: 1.65;
    tab-size: 4;
  }

  .code-viewer :global(.shiki code) {
    display: block;
  }

  .code-viewer :global(.shiki .line) {
    display: inline-block;
    min-width: 100%;
    padding-right: var(--site-space-5);
  }

  .code-viewer :global(.shiki .line)::before {
    display: inline-block;
    width: 3.5rem;
    padding-right: var(--site-space-3);
    color: var(--site-color-text-muted);
    content: counter(source-line);
    counter-increment: source-line;
    font-variant-numeric: tabular-nums;
    text-align: right;
    user-select: none;
  }

  .code-viewer :global(.shiki span) {
    color: var(--shiki-light);
  }

  :global(:root[data-theme="dark"]) .code-viewer :global(.shiki) {
    background: var(--shiki-dark-bg);
    color: var(--shiki-dark);
  }

  :global(:root[data-theme="dark"]) .code-viewer :global(.shiki span) {
    color: var(--shiki-dark);
  }

  .code-unavailable {
    display: grid;
    min-height: 20rem;
    align-content: center;
    justify-items: start;
    gap: var(--site-space-3);
    padding: var(--site-space-6);
  }

  .code-unavailable h3 {
    font-size: 1.25rem;
  }

  .code-unavailable p {
    max-width: 36rem;
    color: var(--site-color-text-secondary);
  }

  @media (max-width: 52rem) {
    .code-browser-header {
      align-items: stretch;
      flex-direction: column;
    }

    .code-browser-actions {
      justify-content: flex-start;
    }

    .code-browser-layout {
      grid-template-columns: 1fr;
    }

    .code-file-navigation {
      max-height: none;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--site-color-border-subtle);
    }

    .code-file-navigation ul {
      display: flex;
      width: max-content;
      max-width: none;
    }

    .code-file-navigation li {
      width: min(15rem, 70vw);
    }

    .code-file-navigation a.active {
      box-shadow: inset 0 -3px var(--site-color-brand);
    }
  }
</style>
