---
import { SampleIcon } from "./SampleIcon";
import type { CatalogCategory, CatalogSample } from "../lib/catalog";
import { sitePath } from "../lib/urls";

interface Props {
  samples: CatalogSample[];
  categories: ReadonlyMap<string, CatalogCategory>;
}

const { samples, categories } = Astro.props;
---

<section class="showcase-stage" aria-labelledby="stage-title" data-showcase-stage>
  <div class="site-container">
    <div class="stage-heading">
      <div class="section-header">
        <p class="eyebrow">A platform, not a pattern library</p>
        <h2 id="stage-title">Windows capabilities, composed into real apps</h2>
        <p class="secondary-text">
          Move from a platform surface to the exact sample, scenarios, and source
          that implement it.
        </p>
      </div>
      <p class="stage-status" data-stage-status>Interactive depth loads when useful.</p>
    </div>

    <div class="stage-visual" aria-hidden="true" data-stage-visual>
      <div class="stage-glow"></div>
      <div class="static-window static-window--back">
        <span class="window-titlebar"></span>
        <span class="window-content"></span>
      </div>
      <div class="static-window static-window--middle">
        <span class="window-titlebar"></span>
        <span class="window-content"></span>
      </div>
      <div class="static-window static-window--front">
        <span class="window-titlebar"></span>
        <span class="window-content"></span>
      </div>
    </div>

    <div class="stage-sample-strip">
      {
        samples.slice(0, 3).map((sample) => {
          const category = categories.get(sample.categories.primary);
          return (
            <article class="stage-card">
              <div class="stage-card-icon">
                <SampleIcon name={sample.icon} />
              </div>
              <div>
                <p>{category?.label ?? sample.categories.primary}</p>
                <h3>
                  <a href={sitePath(`/samples/${sample.id}/`)}>{sample.title}</a>
                </h3>
              </div>
              <span aria-hidden="true">→</span>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-showcase-stage]");
  for (const root of roots) {
    const visual = root.querySelector<HTMLElement>("[data-stage-visual]");
    if (!visual) continue;

    const media = window.matchMedia("(prefers-reduced-motion: reduce)");
    const connection = (
      navigator as Navigator & {
        connection?: { saveData?: boolean };
        deviceMemory?: number;
      }
    ).connection;
    const deviceMemory = (navigator as Navigator & { deviceMemory?: number })
      .deviceMemory;
    const capable =
      !media.matches &&
      !connection?.saveData &&
      (deviceMemory === undefined || deviceMemory >= 4) &&
      window.innerWidth >= 640;
    if (!capable) continue;

    const observer = new IntersectionObserver(
      async ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        try {
          const { initShowcaseStage } = await import("../lib/three-stage");
          initShowcaseStage(visual);
        } catch {
          root.dataset.stageFallback = "true";
        }
      },
      { rootMargin: "300px 0px" },
    );
    observer.observe(root);
  }
</script>

<style>
  .showcase-stage {
    padding-block: var(--site-space-8) 0;
    overflow: clip;
    background:
      linear-gradient(180deg, transparent, color-mix(in srgb, var(--site-color-brand-subtle) 55%, transparent)),
      var(--site-color-canvas);
  }

  .stage-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--site-space-5);
  }

  .stage-heading .section-header {
    margin-bottom: var(--site-space-5);
  }

  .stage-status {
    margin-bottom: var(--site-space-6);
    color: var(--site-color-text-muted);
    font-size: 0.78rem;
  }

  .stage-visual {
    position: relative;
    min-height: clamp(24rem, 50vw, 38rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--site-color-border) 72%, transparent);
    border-bottom: 0;
    border-radius: 2rem 2rem 0 0;
    background:
      linear-gradient(rgb(255 255 255 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 5%) 1px, transparent 1px),
      radial-gradient(circle at 50% 68%, #55c2ff4d, transparent 34%),
      linear-gradient(145deg, #071426, #152d51 58%, #19385a);
    background-size: 4rem 4rem, 4rem 4rem, auto, auto;
    box-shadow: inset 0 1px rgb(255 255 255 / 16%);
    perspective: 70rem;
  }

  .stage-visual :global(canvas) {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .stage-glow {
    position: absolute;
    inset: 36% 18% -35%;
    border-radius: 50%;
    background: #5cc8ff52;
    filter: blur(4rem);
  }

  .static-window {
    position: absolute;
    display: grid;
    grid-template-rows: 2.4rem 1fr;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 32%);
    border-radius: 0.8rem;
    background: rgb(232 245 255 / 14%);
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 35%);
    backdrop-filter: blur(24px) saturate(125%);
  }

  .static-window--back {
    width: 42%;
    height: 46%;
    top: 16%;
    left: 8%;
    transform: rotateY(12deg) rotateZ(-4deg);
  }

  .static-window--middle {
    width: 40%;
    height: 54%;
    top: 11%;
    right: 8%;
    transform: rotateY(-12deg) rotateZ(4deg);
  }

  .static-window--front {
    width: 48%;
    height: 55%;
    right: 26%;
    bottom: -3%;
  }

  .window-titlebar {
    border-bottom: 1px solid rgb(255 255 255 / 18%);
    background:
      radial-gradient(circle at calc(100% - 1.25rem) 50%, #fff 0 2px, transparent 3px),
      rgb(255 255 255 / 8%);
  }

  .window-content {
    margin: 10%;
    border-radius: 0.5rem;
    background:
      linear-gradient(90deg, #54bdfa 0 30%, transparent 30%),
      repeating-linear-gradient(180deg, rgb(255 255 255 / 30%) 0 2px, transparent 2px 1.4rem);
    opacity: 0.75;
  }

  .stage-sample-strip {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: -1px;
    border: 1px solid var(--site-color-border-subtle);
    border-radius: 0 0 1.5rem 1.5rem;
    background: var(--site-color-surface-solid);
    box-shadow: var(--site-shadow-flyout);
  }

  .stage-card {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--site-space-3);
    padding: var(--site-space-5);
  }

  .stage-card + .stage-card {
    border-left: 1px solid var(--site-color-border-subtle);
  }

  .stage-card-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: var(--site-radius-medium);
    background: var(--site-color-brand-subtle);
    color: var(--site-color-brand);
  }

  .stage-card p {
    color: var(--site-color-text-muted);
    font-size: 0.75rem;
  }

  .stage-card h3 {
    overflow: hidden;
    font-size: 1rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stage-card a {
    color: var(--site-color-text);
    text-decoration: none;
  }

  .stage-card a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  @media (max-width: 48rem) {
    .stage-heading {
      display: block;
    }

    .stage-status {
      display: none;
    }

    .stage-visual {
      min-height: 23rem;
    }

    .stage-sample-strip {
      grid-template-columns: 1fr;
    }

    .stage-card + .stage-card {
      border-top: 1px solid var(--site-color-border-subtle);
      border-left: 0;
    }
  }

  @media (forced-colors: active) {
    .stage-visual {
      border: 2px solid CanvasText;
      background: Canvas;
    }

    .static-window {
      border: 2px solid CanvasText;
      background: Canvas;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .stage-card {
      transition: background 160ms ease;
    }

    .stage-card:hover {
      background: var(--site-color-surface-hover);
    }
  }
</style>

