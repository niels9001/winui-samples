---
import type { CatalogCategory } from "../lib/catalog";
import type { RelatedSampleResult } from "../lib/related-samples";
import { resolveHeroMedia } from "../lib/sample-media";
import { getSampleSource } from "../lib/source-provenance";
import {
  sampleDetailPath,
  sitePath,
} from "../lib/urls";
import SampleMedia from "./SampleMedia.astro";

interface Props {
  related: RelatedSampleResult[];
  categories: CatalogCategory[];
}

const { related, categories } = Astro.props;
const categoryById = new Map(
  categories.map((category) => [category.id, category]),
);
const cards = await Promise.all(
  related.map(async (result) => ({
    ...result,
    hero: await resolveHeroMedia(result.sample),
    source: getSampleSource(result.sample),
  })),
);
---

<section
  class="stack related-section"
  aria-labelledby="related-title"
  data-scroll-reveal
>
  <div class="stack section-heading">
    <p class="eyebrow">Continue building</p>
    <h2 id="related-title">Related projects</h2>
    <p class="secondary-text">
      Move to a nearby API, category, or implementation pattern.
    </p>
  </div>

  {
    cards.length > 0 ? (
      <div class="related-grid" role="list">
        {cards.map((result) => (
          <article
            class="related-card surface"
            data-pointer-surface
            data-tilt
            role="listitem"
          >
            <a
              class="related-media-link"
              href={sitePath(sampleDetailPath(result.sample.id))}
              tabindex="-1"
            >
              <SampleMedia
                category={categoryById.get(
                  result.sample.categories.primary,
                )}
                hero={result.hero}
                sample={result.sample}
              />
            </a>
            <div class="stack related-content">
              <p class="related-meta">
                <span>{result.source.label}</span>
                <span>{result.sharedTopics.slice(0, 2).join(" · ")}</span>
              </p>
              <h3>
                <a href={sitePath(sampleDetailPath(result.sample.id))}>
                  {result.sample.title}
                </a>
              </h3>
              <p>{result.sample.summary}</p>
              <span class="related-count">
                {result.sample.scenarios.length} scenarios
              </span>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="related-empty surface">
        <h3>No related projects are available</h3>
        <p>Browse the complete directory to choose another outcome.</p>
      </div>
    )
  }
</section>

<style>
  .related-section {
    --stack-space: var(--site-space-5);
  }

  .section-heading {
    --stack-space: var(--site-space-3);
    max-width: var(--site-reading-width);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--site-space-4);
  }

  .related-card {
    position: relative;
    display: grid;
    overflow: hidden;
    grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 1.2fr);
    box-shadow: none;
  }

  .related-card:hover {
    border-color: var(--site-color-brand);
    box-shadow: var(--site-shadow-flyout);
  }

  .related-card :global(.detail-visual),
  .related-card :global(.detail-visual img),
  .related-card :global(.detail-visual-fallback) {
    height: 100%;
    aspect-ratio: auto;
  }

  .related-card :global(.detail-visual) {
    border: 0;
    border-right: 1px solid var(--site-color-border-subtle);
    border-radius: 0;
    box-shadow: none;
  }

  .related-media-link {
    display: block;
    min-width: 0;
  }

  .related-content {
    --stack-space: var(--site-space-2);
    min-width: 0;
    padding: var(--site-space-4);
  }

  .related-content h3 {
    font-size: 1.12rem;
  }

  .related-content h3 a {
    color: var(--site-color-text);
    text-decoration: none;
  }

  .related-content h3 a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .related-content > p:nth-of-type(2) {
    display: -webkit-box;
    overflow: hidden;
    color: var(--site-color-text-secondary);
    font-size: 0.84rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .related-meta,
  .related-count,
  .related-content h3,
  .related-content > p:nth-of-type(2) {
    position: relative;
  }

  .related-meta,
  .related-count {
    color: var(--site-color-text-muted);
    font-size: 0.68rem;
  }

  .related-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--site-space-2);
  }

  .related-meta span + span::before {
    margin-right: var(--site-space-2);
    content: "·";
  }

  .related-count {
    margin-top: auto;
    padding-top: var(--site-space-2);
  }

  .related-empty {
    display: grid;
    gap: var(--site-space-2);
    padding: var(--site-space-5);
    box-shadow: none;
  }

  .related-empty p {
    color: var(--site-color-text-secondary);
  }

  @media (max-width: 54rem) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34rem) {
    .related-card {
      grid-template-columns: 1fr;
    }

    .related-card :global(.detail-visual),
    .related-card :global(.detail-visual img),
    .related-card :global(.detail-visual-fallback) {
      height: auto;
      aspect-ratio: 16 / 8;
    }

    .related-card :global(.detail-visual) {
      border-right: 0;
      border-bottom: 1px solid var(--site-color-border-subtle);
    }
  }
</style>
