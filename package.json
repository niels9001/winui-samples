{
  "name": "winui-samples",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog:validate": "node tools/catalog/validate.mjs",
    "catalog:validate:complete": "node tools/catalog/validate.mjs --require-complete",
    "catalog:generate": "node tools/catalog/generate.mjs",
    "catalog:generate:site": "node tools/catalog/generate.mjs --require-complete --output site/src/generated/sample-catalog.json",
    "catalog:test": "node --test tools/catalog/test/*.test.mjs",
    "external:validate": "node tools/external-catalog/validate.mjs",
    "external:generate": "node tools/external-catalog/generate.mjs",
    "external:refresh": "node tools/external-catalog/refresh.mjs",
    "external:test": "node --test tools/external-catalog/test/*.test.mjs",
    "external:check": "pnpm --filter @winui-samples/site exec tsc --noEmit -p ../tools/external-catalog/tsconfig.json",
    "external:verify": "pnpm external:test && pnpm external:check && pnpm external:validate && pnpm external:generate",
    "activity:generate": "node tools/activity/generate.mjs",
    "activity:test": "node --test tools/activity/test/*.test.mjs",
    "site:prepare": "pnpm catalog:validate:complete && pnpm external:validate && pnpm catalog:generate:site && pnpm activity:generate",
    "site:check": "pnpm site:prepare && pnpm --filter @winui-samples/site check",
    "site:test": "pnpm site:prepare && pnpm --filter @winui-samples/site test",
    "site:build": "pnpm site:prepare && pnpm --filter @winui-samples/site build",
    "site:smoke": "pnpm --filter @winui-samples/site smoke",
    "site:verify": "pnpm catalog:test && pnpm external:test && pnpm activity:test && pnpm site:prepare && pnpm --filter @winui-samples/site test && pnpm --filter @winui-samples/site check && pnpm --filter @winui-samples/site build && pnpm --filter @winui-samples/site smoke",
    "test": "pnpm catalog:test && pnpm external:test && pnpm activity:test && pnpm site:test"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "es-module-lexer": "2.3.1",
    "yaml": "2.9.0"
  }
}
