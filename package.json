{
  "name": "winui-samples",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog:validate": "node tools/catalog/validate.mjs",
