{
  "name": "winui-samples",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog:validate": "node tools/catalog/validate.mjs",
    "catalog:validate:complete": "node tools/catalog/validate.mjs --require-complete",
    "catalog:generate": "node tools/catalog/generate.mjs",
    "catalog:generate:site": "node tools/catalog/generate.mjs --output site/src/generated/sample-catalog.json",
    "catalog:test": "node --test tools/catalog/test/*.test.mjs",
    "site:prepare": "pnpm catalog:validate && pnpm catalog:generate:site",
    "site:check": "pnpm site:prepare && pnpm --filter @winui-samples/site check",
    "site:test": "pnpm site:prepare && pnpm --filter @winui-samples/site test",
    "site:build": "pnpm site:prepare && pnpm --filter @winui-samples/site build",
    "site:smoke": "pnpm --filter @winui-samples/site smoke",
    "site:verify": "pnpm catalog:test && pnpm site:prepare && pnpm --filter @winui-samples/site test && pnpm --filter @winui-samples/site check && pnpm --filter @winui-samples/site build && pnpm --filter @winui-samples/site smoke",
    "test": "pnpm catalog:test && pnpm site:test"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
